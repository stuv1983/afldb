	 IF affected <> 1 OR audit_id=94 THEN RAISE EXCEPTION 'I316 insert cardinality/id refused'; END IF;
	 PERFORM set_config('afldb.i316.receipt',jsonb_build_object('id',audit_id,'row',audit_row)::text,false);
	END $repair$;
	
	
