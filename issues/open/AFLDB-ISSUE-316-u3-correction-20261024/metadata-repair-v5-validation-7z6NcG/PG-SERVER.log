	 PERFORM set_config('afldb.i316.environment_status',CASE WHEN drift THEN 'CONCURRENT_SCHEMA_DRIFT' ELSE 'CLEAN' END,false);
	END $post$;
	
	
	SELECT 'I316_PRECOMMIT=' || current_setting('afldb.i316.receipt');
	COMMIT;
	
	
