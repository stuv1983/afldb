	SELECT 'I316_PREFLIGHT=' || current_setting('afldb.i316.before');
	SELECT to_regclass('public.brownlow_eligibility_decisions') IS NOT NULL AS i316_optional_0 ;
	SELECT to_regclass('public.brownlow_correction_receipts') IS NOT NULL AS i316_optional_1 ;
	COMMIT;
	
