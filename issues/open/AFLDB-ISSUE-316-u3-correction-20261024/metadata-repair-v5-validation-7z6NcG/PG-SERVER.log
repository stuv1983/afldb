	BEGIN ISOLATION LEVEL SERIALIZABLE;
	
	SET LOCAL lock_timeout='2s';
	SET LOCAL statement_timeout='10min';
	SET LOCAL idle_in_transaction_session_timeout='2min';
	SET LOCAL timezone='UTC';
	SET LOCAL search_path=pg_catalog,public;
	-- Plain LOCK utilities only: no DO, SELECT, regclass expression or catalog query.
	-- Existing protected relations only. Absent optional relations are environment observations.
	LOCK TABLE public.data_edits IN SHARE ROW EXCLUSIVE MODE;
	LOCK TABLE public.auth_users IN SHARE MODE;
	LOCK TABLE public.data_overrides IN SHARE MODE;
	LOCK TABLE public.matches IN SHARE MODE;
	LOCK TABLE public.player_match_stats IN SHARE MODE;
	LOCK TABLE public.match_period_scores IN SHARE MODE;
	LOCK TABLE public.player_match_period_stats IN SHARE MODE;
	LOCK TABLE public.player_career_stats IN SHARE MODE;
	LOCK TABLE public.player_season_stats IN SHARE MODE;
	LOCK TABLE public.player_club_season_stats IN SHARE MODE;
	LOCK TABLE public.player_clubs IN SHARE MODE;
	LOCK TABLE public.players IN SHARE MODE;
	LOCK TABLE public.clubs IN SHARE MODE;
	LOCK TABLE public.club_seasons IN SHARE MODE;
	LOCK TABLE public.seasons IN SHARE MODE;
	LOCK TABLE public.import_batches IN SHARE MODE;
	LOCK TABLE public.import_rejections IN SHARE MODE;
	LOCK TABLE public.canonical_applications IN SHARE MODE;
	LOCK TABLE public.brownlow_season_votes IN SHARE MODE;
	LOCK TABLE public.brownlow_round_votes IN SHARE MODE;
	LOCK TABLE public.brownlow_vote_entry_state IN SHARE MODE;
	LOCK TABLE public.brownlow_season_authority IN SHARE MODE;
	LOCK TABLE public.auth_audit_log IN SHARE MODE;
	LOCK TABLE staging.afltables_player_match IN SHARE MODE;
	LOCK TABLE staging.afltables_match IN SHARE MODE;
	LOCK TABLE staging.afl_api_lineup IN SHARE MODE;
	LOCK TABLE staging.afl_api_brownlow_vote IN SHARE MODE;
	
	
	LOCK TABLE afldb_meta.schema_migrations IN SHARE MODE;
	
	
	
	-- v5 exact database principal: the existing non-superuser owner role afldb_owner, explicitly pinned.
	-- Shared by production and the private-cluster fixture; the instance identity stays in identity.sql.
	-- Privilege-derived acceptance alone is never enough: the role, its attributes, its memberships,
	-- the ownership state and the audit table's exact ACLs must all match what discovery observed.
	DO $principal$
	DECLARE me oid := (SELECT oid FROM pg_catalog.pg_roles WHERE rolname='afldb_owner');
	        seq regclass := pg_catalog.pg_get_serial_sequence('public.data_edits','id')::regclass;
	        required text[] := ARRAY['public.data_edits','public.auth_users','public.data_overrides','public.matches','public.player_match_stats','public.match_period_scores','public.player_match_period_stats','public.player_career_stats','public.player_season_stats','public.player_club_season_stats','public.player_clubs','public.players','public.clubs','public.club_seasons','public.seasons','public.import_batches','public.import_rejections','public.canonical_applications','public.brownlow_season_votes','public.brownlow_round_votes','public.brownlow_vote_entry_state','public.brownlow_season_authority','public.auth_audit_log','staging.afltables_player_match','staging.afltables_match','staging.afl_api_lineup','staging.afl_api_brownlow_vote','afldb_meta.schema_migrations'];
	BEGIN
	 IF me IS NULL OR session_user <> 'afldb_owner' OR current_user <> 'afldb_owner'
	 THEN RAISE EXCEPTION 'I316 principal session/current user refused'; END IF;
	 IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE oid=me AND rolcanlogin AND rolinherit AND NOT rolsuper
	     AND NOT rolcreaterole AND NOT rolcreatedb AND NOT rolreplication AND NOT rolbypassrls)
	 OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE member=me OR roleid=me)
	 OR EXISTS (SELECT 1 FROM pg_catalog.pg_db_role_setting WHERE setrole=me)
	 THEN RAISE EXCEPTION 'I316 principal role attributes/membership refused'; END IF;
	 IF (SELECT datdba FROM pg_catalog.pg_database WHERE datname=current_database()) <> me
	 OR EXISTS (SELECT 1 FROM unnest(required) r WHERE pg_catalog.to_regclass(r) IS NULL
	     OR (SELECT relowner FROM pg_catalog.pg_class WHERE oid=pg_catalog.to_regclass(r)) <> me)
	 OR seq IS NULL OR (SELECT relowner FROM pg_catalog.pg_class WHERE oid=seq) <> me
	 THEN RAISE EXCEPTION 'I316 principal ownership refused'; END IF;
	 IF (SELECT relacl::text FROM pg_catalog.pg_class WHERE oid='public.data_edits'::regclass)
	      IS DISTINCT FROM '{afldb_owner=arwdDxt/afldb_owner,afldb_auth=ar/afldb_owner,afldb_import=ar/afldb_owner}'
	 OR EXISTS (SELECT 1 FROM pg_catalog.pg_attribute WHERE attrelid='public.data_edits'::regclass AND attnum>0 AND attacl IS NOT NULL)
	 OR (SELECT relacl::text FROM pg_catalog.pg_class WHERE oid=seq)
	      IS DISTINCT FROM '{afldb_owner=rwU/afldb_owner,afldb_import=U/afldb_owner,afldb_auth=rU/afldb_owner}'
	 OR (SELECT array_agg(rolname::text ORDER BY rolname::text COLLATE "C") FROM pg_catalog.pg_roles r WHERE NOT r.rolsuper
	       AND pg_catalog.has_column_privilege(r.oid,'public.data_edits'::regclass,'note','UPDATE'))
	      IS DISTINCT FROM ARRAY['afldb_owner','pg_write_all_data']
	 OR EXISTS (SELECT 1 FROM pg_catalog.pg_auth_members WHERE roleid='pg_write_all_data'::regrole)
	 OR NOT pg_catalog.has_column_privilege('public.data_edits','note','UPDATE')
	 OR NOT pg_catalog.has_table_privilege('public.data_edits','INSERT')
	 THEN RAISE EXCEPTION 'I316 principal privilege state refused'; END IF;
	END $principal$;
	SELECT 'I316_PRINCIPAL=' || jsonb_build_object('session_user',session_user,'current_user',current_user,
	 'superuser',(SELECT rolsuper FROM pg_catalog.pg_roles WHERE rolname=current_user),
	 'database_owner',(SELECT pg_catalog.pg_get_userbyid(datdba) FROM pg_catalog.pg_database WHERE datname=current_database()),
	 'read_only',current_setting('transaction_read_only'))::text;
	
	-- First runs after every plain LOCK statement and production identity.
	DO $held$
	DECLARE relname text; expected_mode text;
	        required text[] := ARRAY['public.data_edits','public.auth_users','public.data_overrides','public.matches','public.player_match_stats','public.match_period_scores','public.player_match_period_stats','public.player_career_stats','public.player_season_stats','public.player_club_season_stats','public.player_clubs','public.players','public.clubs','public.club_seasons','public.seasons','public.import_batches','public.import_rejections','public.canonical_applications','public.brownlow_season_votes','public.brownlow_round_votes','public.brownlow_vote_entry_state','public.brownlow_season_authority','public.auth_audit_log','staging.afltables_player_match','staging.afltables_match','staging.afl_api_lineup','staging.afl_api_brownlow_vote','afldb_meta.schema_migrations'];
	BEGIN
	 FOREACH relname IN ARRAY required || ARRAY['public.brownlow_eligibility_decisions','public.brownlow_correction_receipts'] LOOP
	  IF to_regclass(relname) IS NULL THEN
	   IF relname=ANY(required) THEN RAISE EXCEPTION 'I316 required lock relation absent %',relname; END IF;
	  ELSE
	   expected_mode := CASE WHEN relname='public.data_edits' THEN 'ShareRowExclusiveLock' ELSE 'ShareLock' END;
	   IF NOT EXISTS(SELECT 1 FROM pg_catalog.pg_locks WHERE pid=pg_backend_pid() AND locktype='relation'
	     AND relation=to_regclass(relname) AND mode=expected_mode AND granted)
	   THEN RAISE EXCEPTION 'I316 complete protected lock set not held %',relname; END IF;
	  END IF;
	 END LOOP;
	END $held$;
	
	SELECT id FROM public.data_edits WHERE id=94 FOR UPDATE;
	SELECT id FROM public.data_overrides WHERE id=93 FOR SHARE;
	SELECT id FROM public.auth_users WHERE id=1 FOR SHARE;
	-- Expected pre-repair ledger. No migration is run or authorised.
	DO $migration$
	DECLARE expected jsonb := current_setting('afldb.i316.expected_migrations')::jsonb;
	BEGIN
	 IF (SELECT count(*) FROM afldb_meta.schema_migrations) <> jsonb_array_length(expected)
	 OR EXISTS (SELECT 1 FROM jsonb_array_elements(expected) e
	   LEFT JOIN afldb_meta.schema_migrations m ON m.name=e->>'name'
	   WHERE m.name IS NULL OR NOT (e->'checksums' ? m.checksum))
	 THEN RAISE EXCEPTION 'I316 expected pre-repair migration/schema version refused'; END IF;
	END $migration$;
	
	-- Read-only checks shared by preflight and the locked repair transaction.
	DO $checks$
	DECLARE b jsonb := current_setting('afldb.i316.binding')::jsonb;
	        n text := b->>'note';
	BEGIN
	 IF n IS NULL OR length(n) <> 967 OR octet_length(n) <> 967
	 OR encode(sha256(convert_to(n,'UTF8')),'hex') <> '3d2d25ea4919dcdc1cfd8fcaa1b2ede6941e10ab0d07404fa0e2279fcc33621d'
	 THEN RAISE EXCEPTION 'I316 note input refused'; END IF;
	 IF b->'actor' <> '{"id":1,"email":"stuart.villanti@gmail.com","role":"super_admin"}'::jsonb
	 OR (SELECT count(*) FROM public.auth_users WHERE id=1 AND email=b->'actor'->>'email'
	     AND role='super_admin' AND disabled_at IS NULL) <> 1
	 THEN RAISE EXCEPTION 'I316 actor refused'; END IF;
	 IF b->>'approval_sha256' IS DISTINCT FROM current_setting('afldb.i316.approval_sha256')
	 OR b->>'approval_reference' IS DISTINCT FROM 'OWNER-RULING.md (retained 2026-10-25 owner instruction: Accept the unprivileged operational observation as PASS.)'
	 OR b->>'issue' IS DISTINCT FROM 'AFLDB-ISSUE-316'
	 THEN RAISE EXCEPTION 'I316 approval refused'; END IF;
	 IF (SELECT count(*) FROM public.data_edits WHERE id=94) <> 1
	 OR (SELECT to_jsonb(d) FROM public.data_edits d WHERE id=94) IS DISTINCT FROM b->'edit94'
	 OR (SELECT note FROM public.data_edits WHERE id=94) IS NOT NULL
	 THEN RAISE EXCEPTION 'I316 target identity/null guard refused'; END IF;
	 IF (SELECT count(*) FROM public.data_overrides WHERE id=93) <> 1
	 OR (SELECT to_jsonb(o) FROM public.data_overrides o WHERE id=93) IS DISTINCT FROM b->'authority93'
	 THEN RAISE EXCEPTION 'I316 authority refused'; END IF;
	 IF EXISTS (SELECT 1 FROM public.data_edits WHERE field_group='audit_note_repair'
	   AND (old_values->>'target_audit_id'='94' OR new_values->>'target_audit_id'='94'))
	 THEN RAISE EXCEPTION 'I316 prior repair refused'; END IF;
	 IF EXISTS (SELECT 1 FROM pg_catalog.pg_trigger WHERE tgrelid IN ('public.data_edits'::regclass,'public.data_overrides'::regclass) AND NOT tgisinternal)
	 OR EXISTS (SELECT 1 FROM pg_catalog.pg_rewrite WHERE ev_class IN ('public.data_edits'::regclass,'public.data_overrides'::regclass))
	 OR EXISTS (SELECT 1 FROM pg_catalog.pg_class WHERE oid IN ('public.data_edits'::regclass,'public.data_overrides'::regclass) AND (relrowsecurity OR relforcerowsecurity OR relkind<>'r'))
	 THEN RAISE EXCEPTION 'I316 unexpected audit/authority trigger/rule/RLS/relation'; END IF;
	 IF (SELECT jsonb_agg(def ORDER BY def COLLATE "C") FROM
	    (SELECT pg_get_constraintdef(oid) AS def FROM pg_catalog.pg_constraint
	     WHERE conrelid='public.data_edits'::regclass) c) IS DISTINCT FROM b->'audit_constraints'
	 OR (SELECT attidentity FROM pg_catalog.pg_attribute WHERE attrelid='public.data_edits'::regclass AND attname='id') IS DISTINCT FROM 'a'
	 THEN RAISE EXCEPTION 'I316 audit schema/constraint drift'; END IF;
	 IF NOT has_column_privilege(current_user,'public.data_edits','note','UPDATE')
	 OR NOT has_table_privilege(current_user,'public.data_edits','INSERT')
	 THEN RAISE EXCEPTION 'I316 existing role lacks repair privileges'; END IF;
	END $checks$;
	
	DO $canonical$
	BEGIN
	 IF EXISTS (SELECT 1 FROM public.player_match_stats WHERE id=705437 OR (player_id=2121 AND match_id=17214))
	 OR (SELECT count(*) FROM public.player_match_stats p JOIN public.matches m ON m.id=p.match_id WHERE m.season=2026) <> 10028
	 OR (SELECT count(*) FROM public.player_match_stats WHERE match_id=17214 AND club_id=6) <> 23
	 OR (SELECT count(*) FROM staging.afltables_player_match WHERE season=2026) <> 10028
	 OR EXISTS (SELECT 1 FROM public.player_match_stats p JOIN public.matches m ON m.id=p.match_id
	   WHERE m.season=2026 AND NOT EXISTS (SELECT 1 FROM staging.afltables_player_match a
	    WHERE a.season=2026 AND a.match_key=m.match_key AND a.player_id=p.player_id AND a.club_id=p.club_id))
	 OR EXISTS (SELECT 1 FROM staging.afltables_player_match a WHERE a.season=2026 AND NOT EXISTS
	   (SELECT 1 FROM public.player_match_stats p JOIN public.matches m ON m.id=p.match_id
	    WHERE m.season=2026 AND m.match_key=a.match_key AND p.player_id=a.player_id AND p.club_id=a.club_id))
	 THEN RAISE EXCEPTION 'I316 canonical/count/baseline gate refused'; END IF;
	END $canonical$;
	
	-- Logical row fingerprints, not an eligibility/source census. Hash every column,
	-- including NULLs and provenance. Ordered row hashes preserve multiplicity without
	-- aggregating full historical JSON payloads into memory. Full Brownlow representations
	-- and full protected tables are compared, including optional later-schema tables.
	DO $snapshot$
	DECLARE result jsonb := '{}'::jsonb; optional_schema jsonb := '{}'::jsonb; relation text; fingerprint jsonb; schema_state jsonb;
	        required text[] := ARRAY[
	 'public.data_overrides','public.matches','public.player_match_stats','public.match_period_scores',
	 'public.player_match_period_stats','public.player_career_stats','public.player_season_stats',
	 'public.player_club_season_stats','public.player_clubs','public.players','public.clubs',
	 'public.club_seasons','public.seasons','public.import_batches','public.import_rejections',
	 'public.canonical_applications','public.brownlow_season_votes','public.brownlow_round_votes',
	 'public.brownlow_vote_entry_state','public.brownlow_season_authority','public.auth_audit_log',
	 'staging.afltables_player_match','staging.afltables_match','staging.afl_api_lineup','staging.afl_api_brownlow_vote','afldb_meta.schema_migrations'];
	BEGIN
	 FOREACH relation IN ARRAY required || ARRAY['public.brownlow_eligibility_decisions','public.brownlow_correction_receipts'] LOOP
	   IF NOT relation=ANY(required) THEN
	     SELECT jsonb_build_object('present',true,'oid',c.oid,'namespace_oid',c.relnamespace,'kind',c.relkind,
	       'relation',to_jsonb(c)-ARRAY['relpages','reltuples','relallvisible','relfrozenxid','relminmxid'],
	       'columns',(SELECT jsonb_agg(to_jsonb(a) ORDER BY attnum)
	         FROM pg_catalog.pg_attribute a WHERE attrelid=c.oid AND attnum>0),
	       'defaults',(SELECT jsonb_agg(pg_get_expr(adbin,adrelid) ORDER BY adnum) FROM pg_catalog.pg_attrdef WHERE adrelid=c.oid),
	       'indexes',(SELECT jsonb_agg(pg_get_indexdef(indexrelid) ORDER BY indexrelid) FROM pg_catalog.pg_index WHERE indrelid=c.oid),
	       'triggers',(SELECT jsonb_agg(pg_get_triggerdef(oid) ORDER BY oid) FROM pg_catalog.pg_trigger WHERE tgrelid=c.oid),
	       'rules',(SELECT jsonb_agg(pg_get_ruledef(oid) ORDER BY oid) FROM pg_catalog.pg_rewrite WHERE ev_class=c.oid),
	       'constraints',(SELECT jsonb_agg(pg_get_constraintdef(oid) ORDER BY oid) FROM pg_catalog.pg_constraint WHERE conrelid=c.oid))
	       INTO schema_state FROM pg_catalog.pg_class c WHERE c.oid=to_regclass(relation);
	     optional_schema := optional_schema || jsonb_build_object(relation,COALESCE(schema_state,'{"present":false}'::jsonb));
	   END IF;
	   IF to_regclass(relation) IS NULL THEN
	     IF relation=ANY(required) THEN RAISE EXCEPTION 'I316 missing protected relation %',relation; END IF;
	     result := result || jsonb_build_object(relation,jsonb_build_object('absent',true));
	   ELSIF current_setting('afldb.i316.postcommit',true)='true'
	     AND current_setting('afldb.i316.before',true)::jsonb->'protected'->relation = '{"absent":true}'::jsonb THEN
	     -- Newly appeared unrelated optional table: record schema, do not read its data.
	     result := result || jsonb_build_object(relation,jsonb_build_object('environment_only',true));
	   ELSE
	     EXECUTE format('SELECT jsonb_build_object(''count'',count(*),''sha256'',encode(sha256(convert_to(COALESCE(string_agg(h,'''' ORDER BY h COLLATE "C"),''''),''UTF8'')),''hex'')) FROM (SELECT encode(sha256(convert_to(to_jsonb(t)::text,''UTF8'')),''hex'') h FROM %s t) rows',to_regclass(relation)) INTO fingerprint;
	     result := result || jsonb_build_object(relation,fingerprint);
	   END IF;
	 END LOOP;
	 -- Only safe actor identity fields; credentials/session material are never selected.
	 result := result || jsonb_build_object('repair_actor',(SELECT jsonb_build_object('id',id,'email',email,'role',role,'disabled_at',disabled_at) FROM public.auth_users WHERE id=1));
	 PERFORM set_config('afldb.i316.snapshot',jsonb_build_object('protected',result,'optional_schema',optional_schema,
	   'audit_rows',(SELECT COALESCE(jsonb_object_agg(id::text,encode(sha256(convert_to(to_jsonb(d)::text,'UTF8')),'hex')),'{}'::jsonb) FROM public.data_edits d))::text,false);
	END $snapshot$;
	
	DO $fresh$
	BEGIN
	 IF current_setting('afldb.i316.snapshot')::jsonb IS DISTINCT FROM current_setting('afldb.i316.before')::jsonb
	 THEN RAISE EXCEPTION 'I316 state drift after read-only preflight'; END IF;
	END $fresh$;
	SELECT 'I316_LOCKED_OPTIONAL_SCHEMA=' || (current_setting('afldb.i316.snapshot')::jsonb->'optional_schema')::text;
	
	
	-- Exactly two logical writes. No catch block: every exception aborts the transaction.
	DO $repair$
	DECLARE b jsonb := current_setting('afldb.i316.binding')::jsonb;
	        audit_id bigint; affected integer; audit_row jsonb;
	        oldj jsonb; newj jsonb; audit_note text;
	BEGIN
	 oldj := jsonb_build_object('target_audit_id',94,'authority_id',93,'note',NULL);
	 newj := oldj || jsonb_build_object('note',b->>'note','issue',b->>'issue',
	   'approval_reference',b->>'approval_reference','approval_sha256',b->>'approval_sha256',
	   'review_manifest_sha256',current_setting('afldb.i316.manifest_sha256'),
	   'review_record_sha256',current_setting('afldb.i316.review_sha256'),
	   'execution_operator','Claude Code (claude-opus-5-5), delegated by the retained owner instruction; SSH arm -> afldb_owner via the existing protected .env credential, no sudo',
	   'database_session_user',session_user,'database_current_user',current_user,
	   'reason','Approved correction note was missing from the committed audit record; canonical correction state was already separately verified correct. Metadata-only repair.');
	 audit_note := 'AFLDB-ISSUE-316 metadata-only repair of data_edits 94.note; durable removal authority 93 unchanged. Owner approval OWNER-RULING.md SHA-256 '
	   || (b->>'approval_sha256') || '; reviewed manifest SHA-256 ' || current_setting('afldb.i316.manifest_sha256')
	   || '; independent review record SHA-256 ' || current_setting('afldb.i316.review_sha256') || '.';
	 UPDATE public.data_edits d SET note=b->>'note'
	 WHERE id=94 AND note IS NULL AND to_jsonb(d)=b->'edit94';
	 GET DIAGNOSTICS affected=ROW_COUNT;
	 IF affected <> 1 THEN RAISE EXCEPTION 'I316 update cardinality %',affected; END IF;
	 INSERT INTO public.data_edits(table_name,row_id,field_group,old_values,new_values,admin_user_id,note,created_at)
	 VALUES ('matches',17214,'audit_note_repair',oldj,newj,1,audit_note,transaction_timestamp())
	 RETURNING to_jsonb(data_edits),id INTO audit_row,audit_id;
	 GET DIAGNOSTICS affected=ROW_COUNT;
	 IF affected <> 1 OR audit_id=94 THEN RAISE EXCEPTION 'I316 insert cardinality/id refused'; END IF;
	 PERFORM set_config('afldb.i316.receipt',jsonb_build_object('id',audit_id,'row',audit_row)::text,false);
	END $repair$;
	
	
	DO $canonical$
	BEGIN
	 IF EXISTS (SELECT 1 FROM public.player_match_stats WHERE id=705437 OR (player_id=2121 AND match_id=17214))
	 OR (SELECT count(*) FROM public.player_match_stats p JOIN public.matches m ON m.id=p.match_id WHERE m.season=2026) <> 10028
	 OR (SELECT count(*) FROM public.player_match_stats WHERE match_id=17214 AND club_id=6) <> 23
	 OR (SELECT count(*) FROM staging.afltables_player_match WHERE season=2026) <> 10028
	 OR EXISTS (SELECT 1 FROM public.player_match_stats p JOIN public.matches m ON m.id=p.match_id
	   WHERE m.season=2026 AND NOT EXISTS (SELECT 1 FROM staging.afltables_player_match a
	    WHERE a.season=2026 AND a.match_key=m.match_key AND a.player_id=p.player_id AND a.club_id=p.club_id))
	 OR EXISTS (SELECT 1 FROM staging.afltables_player_match a WHERE a.season=2026 AND NOT EXISTS
	   (SELECT 1 FROM public.player_match_stats p JOIN public.matches m ON m.id=p.match_id
	    WHERE m.season=2026 AND m.match_key=a.match_key AND p.player_id=a.player_id AND p.club_id=a.club_id))
	 THEN RAISE EXCEPTION 'I316 canonical/count/baseline gate refused'; END IF;
	END $canonical$;
	
	-- Logical row fingerprints, not an eligibility/source census. Hash every column,
	-- including NULLs and provenance. Ordered row hashes preserve multiplicity without
	-- aggregating full historical JSON payloads into memory. Full Brownlow representations
	-- and full protected tables are compared, including optional later-schema tables.
	DO $snapshot$
	DECLARE result jsonb := '{}'::jsonb; optional_schema jsonb := '{}'::jsonb; relation text; fingerprint jsonb; schema_state jsonb;
	        required text[] := ARRAY[
	 'public.data_overrides','public.matches','public.player_match_stats','public.match_period_scores',
	 'public.player_match_period_stats','public.player_career_stats','public.player_season_stats',
	 'public.player_club_season_stats','public.player_clubs','public.players','public.clubs',
	 'public.club_seasons','public.seasons','public.import_batches','public.import_rejections',
	 'public.canonical_applications','public.brownlow_season_votes','public.brownlow_round_votes',
	 'public.brownlow_vote_entry_state','public.brownlow_season_authority','public.auth_audit_log',
