[Unit]
Description=AFLDB — Australian Football statistics database
Documentation=https://github.com/afldb
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=arm
Group=arm
WorkingDirectory=/home/arm/projects/afldb

# Clustered entry point over the Next.js standalone bundle. SSR is
# CPU-bound and single-threaded, so one process caps out around 46 req/s
# on this host; four workers reach ~214 req/s with p95 under 400ms.
# Node is installed per-user via nvm, so the path is pinned rather than
# relying on PATH.
ExecStart=/home/arm/.nvm/versions/node/v22.23.2/bin/node deploy/server-cluster.mjs

# Credentials come from .env (mode 600, owned by arm) and are never
# baked into the unit file or the environment of other services.
EnvironmentFile=/home/arm/projects/afldb/.env

# .env is the whole project's configuration, so it also holds the import,
# owner, test-owner and backup DSNs. The website needs exactly one of
# them: the read-only app role. Loading the file and then dropping the
# rest keeps one source of configuration while giving the web process
# only the credential it uses — a compromise there cannot reach a role
# that can write, migrate or dump.
#
# These are removed from the environment the service is started with;
# migrations, imports and backups read .env directly and are unaffected.
UnsetEnvironment=AFLDB_IMPORT_DATABASE_URL AFLDB_OWNER_DATABASE_URL AFLDB_TEST_DATABASE_URL AFLDB_BACKUP_DATABASE_URL AFLDB_PROD_DATABASE_URL

Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
# AFLDB_WORKERS and AFLDB_POOL_MAX are deliberately NOT set here. They are
# the one part of this unit that cannot be the same on every host, and
# systemd applies Environment= after EnvironmentFile=, so a value here
# would silently override .env on every machine this unit is installed on.
#
# The two hosts are not comparable: development is 24 cores and 31 GB with
# PostgreSQL alongside a great deal of headroom, production is a 2 vCPU /
# 4 GB droplet with PostgreSQL co-located. One worker count cannot be
# right for both — 4 workers on the droplet oversubscribes 2 vCPUs and
# competes with PostgreSQL for 4 GB, while 2 workers on the development
# host leaves 22 cores idle and costs ~78% of measured throughput.
#
# Each host therefore sets both in its own .env:
#
#   development   AFLDB_WORKERS=4  AFLDB_POOL_MAX=10
#   production    AFLDB_WORKERS=2  AFLDB_POOL_MAX=10
#
# Neither appears in UnsetEnvironment= below, so both reach the service.
# The budget to respect is workers x (AFLDB_POOL_MAX + 3) — the +3 being
# each worker's separate auth pool from src/db/authClient.ts, which is the
# term that gets forgotten.

KillMode=mixed
Restart=always
RestartSec=5
# Give up only after repeated rapid failures, so a crash loop is visible
# rather than silently retried forever.
StartLimitIntervalSec=120
StartLimitBurst=5

# Logging goes to the journal: journalctl -u afldb
StandardOutput=journal
StandardError=journal
SyslogIdentifier=afldb

# --- Hardening -------------------------------------------------------
# The service reads its own directory and talks to PostgreSQL over a
# local socket. It needs nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/arm/projects/afldb/.next
# The apex coming-soon page is PUBLISHED here by /admin/content: the service
# renders index.html and writes the uploaded images, and Caddy serves the
# directory as static files. Without this line ProtectSystem=strict makes the
# whole of /var read-only and every publish fails with EACCES.
#
# The directory must also be owned by this service's user:
#   sudo chown -R arm:caddy /var/www/afldb-soon
#   sudo chmod  750 /var/www/afldb-soon
# Caddy reads it through the group; nothing else needs access. Remove this
# line if AFLDB_APEX_DIR is ever unset, since a writable path granted to a
# web-facing service and then not used is a liability rather than a leftover.
ReadWritePaths=/var/www/afldb-soon
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
