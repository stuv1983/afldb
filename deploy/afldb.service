[Unit]
Description=AFLDB — Australian Football statistics database
Documentation=https://github.com/afldb
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=arm
Group=arm
WorkingDirectory=/home/arm/projects/afldb

# Clustered entry point over the Next.js standalone bundle. SSR is
# CPU-bound and single-threaded, so one process caps out around 46 req/s
# on this host; four workers reach ~214 req/s with p95 under 400ms.
# Node is installed per-user via nvm, so the path is pinned rather than
# relying on PATH.
ExecStart=/home/arm/.nvm/versions/node/v22.23.2/bin/node deploy/server-cluster.mjs

# Credentials come from .env (mode 600, owned by arm) and are never
# baked into the unit file or the environment of other services.
EnvironmentFile=/home/arm/projects/afldb/.env

# .env is the whole project's configuration, so it also holds the import,
# owner, test-owner and backup DSNs. The website needs exactly one of
# them: the read-only app role. Loading the file and then dropping the
# rest keeps one source of configuration while giving the web process
# only the credential it uses — a compromise there cannot reach a role
# that can write, migrate or dump.
#
# These are removed from the environment the service is started with;
# migrations, imports and backups read .env directly and are unaffected.
UnsetEnvironment=AFLDB_IMPORT_DATABASE_URL AFLDB_OWNER_DATABASE_URL AFLDB_TEST_DATABASE_URL AFLDB_BACKUP_DATABASE_URL AFLDB_PROD_DATABASE_URL

Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
# Worker count and pool size are one decision, not two: every worker holds
# its own app pool AND its own auth pool, so this service can hold
# workers x (AFLDB_POOL_MAX + 3) connections.
#
# Sized for the production droplet: 2 vCPU, 4 GB, PostgreSQL co-located on
# the same box (max_connections 100). One worker per vCPU, and the pool
# back at its default:
#
#   2 workers x (10 + 3) = 26 connections against a limit of 100
#
# The 24-core development host runs 4 workers; this is not that box. Raise
# AFLDB_WORKERS only after journalctl shows CPU saturation arriving before
# memory pressure — on 4 GB shared with PostgreSQL, memory is the more
# likely ceiling, and each extra worker costs both.
Environment=AFLDB_WORKERS=2
Environment=AFLDB_POOL_MAX=10

KillMode=mixed
Restart=always
RestartSec=5
# Give up only after repeated rapid failures, so a crash loop is visible
# rather than silently retried forever.
StartLimitIntervalSec=120
StartLimitBurst=5

# Logging goes to the journal: journalctl -u afldb
StandardOutput=journal
StandardError=journal
SyslogIdentifier=afldb

# --- Hardening -------------------------------------------------------
# The service reads its own directory and talks to PostgreSQL over a
# local socket. It needs nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/arm/projects/afldb/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
