[Unit]
Description=AFLDB — in-season AFL.com.au (afl_api) canonical settle (one run)
Documentation=https://github.com/afldb
After=network-online.target postgresql.service afldb.service
Wants=network-online.target

[Service]
Type=oneshot
User=arm
Group=arm
WorkingDirectory=/home/arm/projects/afldb

# The AFLDB-ISSUE-228 S8 chain, in one script so both steps agree on one
# season and one acquired snapshot label:
#
#   acquire-afl-api.ts --season <S>
#     -> settle-afl-api.ts --label <L> --apply --auto-apply --require-complete-source
#
# Runs under `set -e`: a failed acquisition never reaches settle and
# PostgreSQL is never opened. acquire-afl-api.ts writes its manifest LAST and
# self-cleans a manifest-less partial snapshot on the way out (its own
# `cleanupPartialSnapshot()`), so this unit needs no separate cleanup step.
#
# This unit and afldb-settle-afltables.service are independent and may run
# concurrently: they settle different sources against the co-source
# ownership policy (§7.5, Q1) — an afltables-owned row observed here is
# corroborated, never overwritten, and vice versa. Neither unit names the
# other.
# Invoked through /bin/sh rather than relying on an executable bit, same
# convention as afldb-settle-afltables.service.
ExecStart=/bin/sh /home/arm/projects/afldb/deploy/afldb-settle-afl-api.sh

# A season's CONCLUDED-match acquisition plus settle is bounded network and
# database work, but AFL.com.au is a third party. Bound the run rather than
# letting a stalled fetch hold the unit open until the next firing.
TimeoutStartSec=3600

# PostgreSQL is co-located on a 2 vCPU droplet and this job is not urgent.
Nice=10

# Credential boundary (AFLDB-ISSUE-232). The run keeps exactly two DSNs:
# DATABASE_URL (afldb_app — the ingestion-switch read) and
# AFLDB_IMPORT_DATABASE_URL (afldb_import — the settle's only writer). Every
# other *_DATABASE_URL .env.example defines is dropped below: the schema
# owner, auth, backup, every test/code-test DSN and the DEV/PROD operator
# maintenance DSNs. So are the secrets this run never uses: session, SMTP,
# e-mail intake (route secret and IMAP login), revalidation (D-232-3: no
# automatic revalidateSeason()) and the Kali API key. Non-secret settings
# (the AFL API base URLs, the outbound User-Agent) are kept.
#
# This is a hand-typed deny list, the shape AFLDB-ISSUE-220 found drifting
# on the web unit. tests/afl-api-ingestion-safety.test.ts derives every
# *_DATABASE_URL name and every credential-shaped name from .env.example on
# each run and fails if one is missing here; a failure there is a credential
# leak in waiting, never a test to adjust.
EnvironmentFile=/home/arm/projects/afldb/.env
UnsetEnvironment=AFLDB_OWNER_DATABASE_URL AFLDB_AUTH_DATABASE_URL AFLDB_TEST_DATABASE_URL AFLDB_TEST_IMPORT_DATABASE_URL AFLDB_TEST_AUTH_DATABASE_URL AFLDB_CODE_TEST_DATABASE_URL AFLDB_CODE_TEST_IMPORT_DATABASE_URL AFLDB_DEV_DATABASE_URL AFLDB_DEV_IMPORT_DATABASE_URL AFLDB_BACKUP_DATABASE_URL AFLDB_PROD_DATABASE_URL AFLDB_PROD_IMPORT_DATABASE_URL AFLDB_PROD_AUTH_DATABASE_URL AFLDB_SESSION_SECRET AFLDB_SMTP_USER AFLDB_SMTP_PASSWORD AFLDB_EMAIL_INTAKE_SECRET AFLDB_INTAKE_IMAP_USER AFLDB_INTAKE_IMAP_PASSWORD AFLDB_REVALIDATE_SECRET KALI_AFL_API_KEY

StandardOutput=journal
StandardError=journal
SyslogIdentifier=afldb-settle-afl-api

# --- Hardening -------------------------------------------------------
# Modelled on afldb-settle-afltables.service. `ReadWritePaths` is narrower:
# afl_api snapshots and manifests live entirely under data/sources/afl_api
# (untracked, .gitignore'd) — there is no tracked
# docs/rebuild-manifests/afl_api/<label>.json copy step in the current
# acquire-afl-api.ts implementation (see this pass's session report), so no
# docs/rebuild-manifests path is granted write access here.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/arm/projects/afldb/data/sources/afl_api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Node JIT, as in afldb.service / afldb-settle-afltables.service.
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
