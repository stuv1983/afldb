[Unit]
Description=AFLDB — AFL.com.au (afl_api) Brownlow live-count settle (one run)
Documentation=https://github.com/afldb
After=network-online.target postgresql.service afldb.service
Wants=network-online.target

[Service]
Type=oneshot
User=arm
Group=arm
WorkingDirectory=/home/arm/projects/afldb

# §10 "Operational enablement" (DECIDED 2026-09-19, carried into S7/S8): this
# unit is INDEPENDENT of afldb-settle-afl-api.service — its own unit, its own
# flag (AFLDB_AFL_API_BROWNLOW_ENABLED), never bundled behind the match
# timer. The wrapper script checks that flag before doing anything, so this
# unit is a safe no-op outside the live count even while its timer stays
# permanently enabled.
#
#   acquire-afl-api.ts --season <S> --fixtures-only
#     -> settle-afl-api-fixtures.ts --label <F> --apply
#     -> acquire-afl-api-brownlow.ts --season <S>
#     -> settle-afl-api-brownlow.ts --label <L> --apply --auto-apply --use-fixture-identity
#
# AFLDB-ISSUE-232 (operator decisions 2026-09-26): D-232-1 = B adds
# --use-fixture-identity, reversing AFLDB-ISSUE-244 §40; O1 refreshes fixture
# identity inside this run (steps 1-2) instead of relying on the match timer.
# No After=/Requires= on afldb-settle-afl-api.service is added: ordering is
# the wrapper's, and systemd cannot make this 5-minute timer wait for a daily
# one. Steps 1-2 also need the AFL API current-season ingestion switch.
#
# Do NOT point this at the live AFL endpoint before it has been exercised
# end-to-end against the local Brownlow simulator in both --observe-only and
# apply mode (§10; run settle-afl-api-brownlow.ts directly for either mode —
# this unit always runs the apply path).
ExecStart=/bin/sh /home/arm/projects/afldb/deploy/afldb-settle-afl-api-brownlow.sh

# A live-count poll is small (one season feed, one leaderboard feed); bound it
# well short of the next timer firing rather than letting a stalled fetch
# overlap the next one (systemd merges a start into an already-running job,
# so this also bounds how long a stuck run can block the next poll).
TimeoutStartSec=180

Nice=5

# Same DSN-exposure reasoning as the other two settle units:
# settle-afl-api-brownlow.ts writes through AFLDB_IMPORT_DATABASE_URL and
# reads the mandatory ingestion gate through DATABASE_URL. Both are retained;
# every other credential .env carries is dropped.
EnvironmentFile=/home/arm/projects/afldb/.env
UnsetEnvironment=AFLDB_OWNER_DATABASE_URL AFLDB_AUTH_DATABASE_URL AFLDB_TEST_DATABASE_URL AFLDB_DEV_DATABASE_URL AFLDB_BACKUP_DATABASE_URL AFLDB_PROD_DATABASE_URL AFLDB_SESSION_SECRET AFLDB_SMTP_PASSWORD AFLDB_SMTP_USER AFLDB_EMAIL_INTAKE_SECRET AFLDB_REVALIDATE_SECRET

StandardOutput=journal
StandardError=journal
SyslogIdentifier=afldb-settle-afl-api-brownlow

# --- Hardening -------------------------------------------------------
# Modelled on afldb-settle-afl-api.service. The grant is the whole
# data/sources/afl_api subtree, the same grant as that unit: this run writes
# data/sources/afl_api/fixtures/<label>/ (steps 1-2, AFLDB-ISSUE-232 O1) and
# data/sources/afl_api/brownlow/<label>/ (steps 3-4). Both sit under the one
# path below, so O1 needs no second ReadWritePaths= line, and a narrower
# per-subtree grant would make the unit fail to start until each directory
# existed.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/arm/projects/afldb/data/sources/afl_api
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
