# AFLDB reverse proxy — DEVELOPMENT SERVER ONLY
#
# This configuration deliberately does NOT reference afldb.com. It binds
# a dedicated port on the development server so it cannot disturb the
# other services already running on this host, and so the production
# domain remains untouched.
#
# The production configuration is set out in docs/production-cutover.md
# and must not be applied until the readiness gate passes.

# ACCESS LOGS CARRY NO SECRETS (AFLDB-ISSUE-362 SEC-1).
#
# Caddy's JSON access log records the whole request URI and the Referer, so a
# plain `format json` writes /beta/verify?token=<magic-link token>,
# /admin/invite/<invite token> and every search query verbatim, whatever
# `level` says. This filter rewrites the logged `uri` (invite token replaced,
# whole query string dropped) and cuts Referer to its origin. It is imported by
# the site log AND the global default log: when the upstream is down Caddy
# writes an ERROR record with the whole request to its own stderr, which the
# site log never sees. Keep it identical to deploy/Caddyfile.production.
# The second rule redacts the token wherever `invite` and a separator appear in
# the raw target, so a denied or odd spelling (`//admin/invite/<token>`,
# `/./admin/invite/...`, `%2F`, `/%69nvite/`, any case) is logged without it too.
(afldb_log_format) {
	format filter {
		wrap json
		fields {
			request>uri multi_regexp {
				regexp "^/admin/invite/[^/?#]+" "/admin/invite/REDACTED"
				regexp "(?i)(?:i|%[46]9)(?:n|%[46]e)(?:v|%[57]6)(?:i|%[46]9)(?:t|%[57]4)(?:e|%[46]5)(?:/|%2f|[\\]|%5c)+[^?#]*" "invite/REDACTED"
				regexp "\?.*$" ""
			}
			request>headers>Referer regexp "^(https?://[^/?#]+).*$" "${1}/"
		}
	}
}

# PATH-SHAPE PROTECTION FOR THE ISR ROUTES (AFLDB-ISSUE-357, owner option O-1).
#
# Next.js persists every rendered page of an ISR route to disk, a 404 or a
# redirect included (about 7 files / 50 KB per distinct path). A path that
# cannot be a canonical URL is therefore answered 404 here, before it reaches
# Next. Four layers (long path, path aliasing, encoded first segment, one
# allow-list per route), every one matched on the RAW request target
# ({http.request.uri}), never on Caddy's decoded and cleaned `path`. The full
# rationale, the canonical shapes and the measured test matrix are in the
# comment above this snippet in deploy/Caddyfile.production and in
# docs/v2/evidence/remediation-20261114/run2/caddy357/README.md.
# Keep it identical to deploy/Caddyfile.production.
(afldb_path_shape) {
	# 1. An implausibly long raw path (query string excluded). The longest path
	#    of a build (a /_next asset) is about 100 characters and the longest
	#    player page 40; 512 leaves ample room.
	@afldb_path_long vars_regexp {http.request.uri} ^[^?]{513,}
	respond @afldb_path_long "Not Found" 404

	# 2. Path aliasing: a doubled slash, a `.` or `..` segment, or an encoded
	#    slash, backslash or dot. No URL the application emits contains one, and
	#    each is a way to name an ISR path that the allow-lists below would not
	#    recognise as protected.
	@afldb_path_alias vars_regexp {http.request.uri} ^[^?]*(//|/[.]{1,2}(/|[?]|$)|%2[EeFf]|%5[Cc])
	respond @afldb_path_alias "Not Found" 404

	# 3. An encoded character in the FIRST segment (`/%73easons/...`): every
	#    route here starts with a plain word.
	@afldb_path_first_segment vars_regexp {http.request.uri} ^/[^/?]*%
	respond @afldb_path_first_segment "Not Found" 404

	# 4. One allow-list per ISR route. The trigger is the raw prefix followed by
	#    at least one path character (so `/seasons/` and `/seasons/?x=1`, the
	#    list page, are left to the application). Allowed: the canonical shape
	#    with an optional query string, nothing else.
	@afldb_bad_player {
		vars_regexp {http.request.uri} ^/players/[^?]
		not vars_regexp {http.request.uri} ^/players/(compare|[a-z0-9-]{1,100}-([1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])(/matches)?)([?].*)?$
	}
	respond @afldb_bad_player "Not Found" 404

	@afldb_bad_match {
		vars_regexp {http.request.uri} ^/matches/[^?]
		not vars_regexp {http.request.uri} ^/matches/[1-9][0-9]{0,4}([?].*)?$
	}
	respond @afldb_bad_match "Not Found" 404

	@afldb_bad_season {
		vars_regexp {http.request.uri} ^/seasons/[^?]
		not vars_regexp {http.request.uri} ^/seasons/(189[7-9]|19[0-9][0-9]|20[0-9][0-9]|2100)([?].*)?$
	}
	respond @afldb_bad_season "Not Found" 404

	@afldb_bad_brownlow {
		vars_regexp {http.request.uri} ^/brownlow/[^?]
		not vars_regexp {http.request.uri} ^/brownlow/(189[7-9]|19[0-9][0-9]|20[0-9][0-9]|2100)([?].*)?$
	}
	respond @afldb_bad_brownlow "Not Found" 404

	@afldb_bad_club {
		vars_regexp {http.request.uri} ^/clubs/[^?]
		not vars_regexp {http.request.uri} ^/clubs/[a-z0-9-]{1,80}([?].*)?$
	}
	respond @afldb_bad_club "Not Found" 404

	@afldb_bad_venue {
		vars_regexp {http.request.uri} ^/venues/[^?]
		not vars_regexp {http.request.uri} ^/venues/[a-z0-9-]{1,80}(/matches)?([?].*)?$
	}
	respond @afldb_bad_venue "Not Found" 404

	@afldb_bad_honour_team {
		vars_regexp {http.request.uri} ^/honour-teams/[^?]
		not vars_regexp {http.request.uri} ^/honour-teams/[a-z0-9-]{1,80}([?].*)?$
	}
	respond @afldb_bad_honour_team "Not Found" 404

	@afldb_bad_sitemap {
		vars_regexp {http.request.uri} ^/sitemap/[^?]
		not vars_regexp {http.request.uri} ^/sitemap/[0-9]{1,3}[.]xml([?].*)?$
	}
	respond @afldb_bad_sitemap "Not Found" 404
}

# Global options. The snippets above are defined first because a global block
# cannot import a snippet that is defined after it.
{
	# Caddy's default log (stderr, so the journal).
	log {
		import afldb_log_format
	}
}

:8090 {
	# Refuse a path that cannot be a canonical URL before it reaches Next's
	# ISR cache (AFLDB-ISSUE-357): see the (afldb_path_shape) snippet.
	import afldb_path_shape

	# Next.js listens on loopback only; the proxy is the sole public face.
	# PostgreSQL is never exposed.
	reverse_proxy 127.0.0.1:3100 {
		health_uri /api/health
		health_interval 30s
		health_timeout 5s

		# Overwrite (not append) X-Forwarded-For with the real client address,
		# so a client-supplied "X-Forwarded-For: 1.2.3.4" cannot reach the app
		# and forge the IP recorded in auth_sessions / auth_audit_log. The app
		# (requestIp) reads the rightmost hop; the two together keep the audit
		# trail honest. The production reverse proxy MUST do the same.
		header_up X-Forwarded-For {remote_host}

		# Drop the other address headers a client might send. The app does not
		# read these, and removing them here means it never can by accident:
		# a future reader of X-Real-IP would otherwise be trusting whatever the
		# client typed. The production reverse proxy MUST do the same.
		header_up -X-Real-IP
		header_up -Forwarded
	}

	encode gzip zstd

	header {
		# Next.js also sets these; the proxy enforces them for any
		# response it serves itself (errors, health failures).
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin

		# Do NOT send HSTS here: the dev server is reached over plain
		# HTTP on the LAN, and HSTS would poison browsers for this host.

		# Never advertise the stack.
		-Server
		-X-Powered-By
	}

	# Health checks should not be cached anywhere.
	@health path /api/health
	header @health Cache-Control "no-store"

	log {
		output file /var/log/caddy/afldb-access.log {
			roll_size 20MiB
			roll_keep 5
		}
		# Query strings and the invite token stay out of the logs: see the
		# (afldb_log_format) snippet at the top of this file.
		import afldb_log_format
		level INFO
	}
}
