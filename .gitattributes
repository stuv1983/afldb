# AFLDB-ISSUE-108 — platform-independent bytes for hash-bound artefacts.
#
# tools/migration/import_fitzroy_core.py (verify_accepted_binding) and
# tests/db-test-rebuild.test.ts bind data/reference/fitzroy-accepted-baselines.json
# to the SHA-256 of the acquisition manifest FILE. A CRLF checkout on Windows
# changed those bytes and broke the binding on one platform only. Force LF on
# checkout for every tracked artefact whose exact bytes are hashed or compared,
# so `sha256_file()` is the same on every platform.
docs/rebuild-manifests/**       text eol=lf
data/reference/*.json           text eol=lf
tools/rebuild/**/*.json          text eol=lf

# AFLDB-ISSUE-113 — the season-grain Brownlow artefact, its manifest and the identity
# adjudication file are hash-bound (manifest csv_sha256 / identity.csv_sha256), so their
# bytes must be identical on every platform.
data/brownlow/*.csv             text eol=lf
data/brownlow/*.json            text eol=lf
# AFLDB-ISSUE-118 §23.29: father_son.py normalize --check compares bytes with the regeneration
data/players/father-son-*.csv   text eol=lf
data/players/father-son-*.json  text eol=lf
# AFLDB-ISSUE-118 §23.31: family_siblings.py normalize --check compares bytes likewise
data/players/sibling-*.csv      text eol=lf
data/players/sibling-*.json     text eol=lf
# AFLDB-ISSUE-118 §23.33: after_siren.py normalize --check compares bytes likewise
data/records/after-siren-*.csv  text eol=lf
data/records/after-siren-*.json text eol=lf

# AFLDB-ISSUE-118 Stage 2 — the captured Gridley payloads are exact response
# bytes and tests/gridley-acquisition.test.ts pins their SHA-256. `-text`
# rather than `text eol=lf`: these are a capture, not a source file, so git
# must not rewrite a line ending inside them under any platform's checkout
# rules. Nothing else in the repository hashes a file the source wrote.
tests/fixtures/gridley/*.json   -text

# AFLDB-ISSUE-118 Stage E2 — the tracked parsed coaches snapshot is hash-bound by its
# manifest (parsed[].sha256), so its bytes must be identical on every platform.
data/sources/afltables/coaches/**/*.csv  text eol=lf
docs/rebuild-manifests/draftguru/bridge-operator-verdicts-issue224-20260919-v1.json -text -diff !eol
docs/rebuild-manifests/draftguru/issue224-population-classification-20260919.json -text -diff !eol

# AFLDB-ISSUE-224 / ISSUE-228 S9 — the target set and the D-7 operator decision are
# both hash-pinned by sha256 AND rows_sha256 in issues.md, IssuesIndex.md and the two
# issue records, and each is regenerated by a `--check` mode that compares on-disk
# bytes. Git must not rewrite a line ending inside either one under any platform's
# checkout rules, or every quoted hash becomes platform-dependent.
docs/rebuild-manifests/draftguru/issue224-s9-target-set-20260922.json -text -diff !eol
docs/rebuild-manifests/draftguru/issue224-d7-registration-decision-20260922.json -text -diff !eol

# AFLDB-ISSUE-229 / 231 / 233 — authentic AFL API response bytes copied verbatim from the
# 2026-09-19 captures, each pinned by sha256 in its issue record and asserted by
# tests/afl-api-match.test.ts. Never converted, never diffed as text. Exception:
# 00-season-matches-2026.raw.json is a sanitised derivative (one third-party ticket-queue token
# value redacted); both hashes are in the ISSUE-231 runbook §2a.
tests/fixtures/afl_api/seasons/*.raw.json -text -diff !eol
tests/fixtures/afl_api/match/04-season-feed-scheduled.raw-slice.json -text -diff !eol
