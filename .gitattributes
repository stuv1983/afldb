# AFLDB-ISSUE-108 — platform-independent bytes for hash-bound artefacts.
#
# tools/migration/import_fitzroy_core.py (verify_accepted_binding) and
# tests/db-test-rebuild.test.ts bind data/reference/fitzroy-accepted-baselines.json
# to the SHA-256 of the acquisition manifest FILE. A CRLF checkout on Windows
# changed those bytes and broke the binding on one platform only. Force LF on
# checkout for every tracked artefact whose exact bytes are hashed or compared,
# so `sha256_file()` is the same on every platform.
docs/rebuild-manifests/**       text eol=lf
data/reference/*.json           text eol=lf
tools/rebuild/**/*.json          text eol=lf

# AFLDB-ISSUE-113 — the season-grain Brownlow artefact, its manifest and the identity
# adjudication file are hash-bound (manifest csv_sha256 / identity.csv_sha256), so their
# bytes must be identical on every platform.
data/brownlow/*.csv             text eol=lf
data/brownlow/*.json            text eol=lf

# AFLDB-ISSUE-118 Stage 2 — the captured Gridley payloads are exact response
# bytes and tests/gridley-acquisition.test.ts pins their SHA-256. `-text`
# rather than `text eol=lf`: these are a capture, not a source file, so git
# must not rewrite a line ending inside them under any platform's checkout
# rules. Nothing else in the repository hashes a file the source wrote.
tests/fixtures/gridley/*.json   -text

# AFLDB-ISSUE-118 Stage E2 — the tracked parsed coaches snapshot is hash-bound by its
# manifest (parsed[].sha256), so its bytes must be identical on every platform.
data/sources/afltables/coaches/**/*.csv  text eol=lf
