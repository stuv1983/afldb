== review2-race.sh (final; attempt 1 watcher stopped by pkill after the dump appeared and lost the timing; attempt 2 used kill -0, which never fails on the zombie child, and hung)
   | # sourced before the timer is armed (review-race only)
   | install -m 644 /in/fix/review2-watch.sh /tmp/review2-watch.sh
   | as_arm setsid bash /tmp/review2-watch.sh > /tmp/review2-watch.log 2>&1 < /dev/null &
   | L FIXTURE-ATTACK "review-race: arm watcher started OUTSIDE afldb-backup.service (setsid, uid 1000, no groups) before the dispatch"

== review2-judge.sh (final; attempt 1 watcher stopped by pkill after the dump appeared and lost the timing; attempt 2 used kill -0, which never fails on the zombie child, and hung)
   | # sourced after the callers ran (review-race only)
   | hdr "[REVIEW2] arm watcher log (an arm process outside the attested invocation)"; sed 's/^/   | /' /tmp/review2-watch.log
   | read -r SUBN SUBS < /home/arm/review2-sub.txt 2>/dev/null
   | REC=$(ls -1 $RD/*.attest 2>/dev/null | head -1)
   | line "[REVIEW2] substituted: $SUBN $SUBS; root record $REC: $(grep -E '^(trigger_unit|dump|dump_sha256)=' "$REC" 2>/dev/null | tr '\n' ' ')"
   | line "RESULT-REVIEW2 G0: exit $(cat $OUT/G0.rc); '$(grep '^G0 PROD RESULT' $OUT/G0.out)'; '$(grep '^OFFHOST-COMPARE' $OUT/G0.out)'"
   | line "RESULT-REVIEW2 A-2 s5: '$(grep '^OFFHOST-COMPARE' $OUT/A2.out)'"
   | if [ -n "$SUBS" ] && grep -qx "OFFHOST-COMPARE $SUBN $SUBS" $OUT/G0.out && grep -qx "dump_sha256=$SUBS" "$REC"; then
   |   line "FINDING-REVIEW2-RACE: G0 exit $(cat $OUT/G0.rc) PASS; the ROOT record binds, and OFFHOST-COMPARE names, bytes an arm process outside the run substituted ($SUBS)"
   | else line "REVIEW2-RACE: the substituted bytes were NOT accepted"; fi

== review2-watch.sh (final; attempt 1 watcher stopped by pkill after the dump appeared and lost the timing; attempt 2 used kill -0, which never fails on the zombie child, and hung)
   | # INDEPENDENT REVIEW 2 (attempt 2): an ARM process OUTSIDE the attested invocation (started before the dispatch, as arm's crontab or
   | # any lingering arm process could be on production). It never touches the checkout, the unit, the record, the sidecar or node.
   | # Deterministic, no timing race: while backup.sh (pg_dump on production, minutes) runs, it SIGSTOPs the PARENT scheduled-backup.sh
   | # (same uid); the child keeps running; once backup.sh has exited (the dump renamed into place), it substitutes the bytes, then SIGCONT.
   | BK=/home/arm/backups/afldb-scheduled
   | log() { printf '%s %s\n' "$(date +%T.%N | cut -c1-12)" "$*"; }
   | log "watcher uid=$(id -u) groups=$(id -G) pid=$$ cgroup=$(cat /proc/self/cgroup)"
   | until c=$(pgrep -u arm -f 'maintenance/backup.sh') && [ -n "$c" ]; do sleep 0.02; done
   | p=$(ps -o ppid= -p "$c" | tr -d ' '); log "backup.sh running: pid $c, parent $p: $(tr '\0' ' ' < /proc/$p/cmdline); parent cgroup $(cat /proc/$p/cgroup)"
   | kill -STOP "$p"; log "SIGSTOP parent $p: state $(awk '{print $3}' /proc/$p/stat)"
   | while st=$(awk '{print $3}' /proc/$c/stat 2>/dev/null) && [ "$st" != Z ]; do sleep 0.05; done   # the exited child stays a zombie (its parent is stopped)
   | f=$(ls -1 "$BK"/afldb_prod-*.dump | head -1); log "backup.sh exited; dump $f real bytes sha256 $(sha256sum < "$f" | cut -c1-64)"
   | printf 'HAND-MADE: bytes chosen by an arm process outside the attested run, not written by the timer-dispatched backup.sh\n' > "$BK/.sub" && mv -f "$BK/.sub" "$f"
   | log "substituted $f: sha256 $(sha256sum < "$f" | cut -c1-64)"
   | kill -CONT "$p"; log "SIGCONT parent $p"
   | printf '%s %s\n' "${f##*/}" "$(sha256sum < "$f" | cut -c1-64)" > /home/arm/review2-sub.txt
