#!/usr/bin/python3.12 -I -S
# afldb-verify-rootfacts (R6 r7, MED-2): the ROOT facts reader. ROOT-OWNED, pinned by SHA256SUMS. Started ONLY by systemd for one
# connection on /run/afldb-verify-rootfacts.sock (afldb-verify-rootfacts.socket: root:afldb-verify 0660, Accept=yes), as
# `/usr/bin/python3.12 -I -S <this file>` in afldb-verify-rootfacts@.service (root with ONLY CAP_DAC_READ_SEARCH and CAP_SYS_PTRACE,
# read-only file system, no network, NoNewPrivileges); stdin/stdout are the connection.
# WHY it exists (verifier README "root facts"): the verifier account is not arm and not root, so it cannot traverse /home/arm (0750),
# read arm's 0700 backup state, arm's crontab spool or the 0700 off-host copy, or readlink /proc/<arm pid>/cwd. This reader answers
# ONE request from a FIXED grammar with FIXED paths; the client supplies no path:
#   a2 | g0                     (role prod)       g0b <YYYY-MM-DD> <afldb_prod-YYYYMMDD-02MMSS.dump>   (role offhost)
# It executes nothing arm owns (only /usr/bin/systemctl show, for MainPID), never follows a symbolic link in any component of an
# arm path (openat O_NOFOLLOW from /), opens leaves O_NONBLOCK and accepts only regular files owned by arm or root, caps sizes, and
# prints key<TAB>value lines whose values are printable ASCII only (arm-owned content is DATA: it cannot add a line or a key).
# It never prints a secret: of .env it counts two key prefixes. Last line "end<TAB>ok"; any failure prints "end<TAB>error".
import hashlib, json, os, pwd, re, socket, stat, subprocess, sys

ROLE_FILE = '/etc/afldb-verify/role'
CHK = '/home/arm/projects/afldb'
RELROOT = '/home/arm/afldb-releases'
BK = '/home/arm/backups/afldb-scheduled'
A1 = '/home/arm/a1-rawhead-baseline.json'
DEST = '/mnt/ssd/afldb-offhost-prod'
PULL_LOG = '/home/arm/afldb-ops/state/offhost-pull.log'
CRONTAB = '/var/spool/cron/crontabs/arm'
RELID = re.compile(r'[0-9a-f]{12}-[A-Za-z0-9_-]{1,64}')
out = []


def emit(k, v):
    out.append('%s\t%s' % (k, re.sub(r'[^\x20-\x7e]', '?', str(v))[:2000]))


def walk(path, leaf_dir=False):
    """fd of path, opened component by component from / with O_NOFOLLOW (a symbolic link anywhere raises OSError ELOOP/ENOTDIR)."""
    parts = [p for p in path.split('/') if p]
    if any(p in ('.', '..') for p in parts):
        raise OSError('bad path')
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for i, p in enumerate(parts):
            last = i == len(parts) - 1
            fl = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC
            fl |= os.O_DIRECTORY if (not last or leaf_dir) else os.O_NONBLOCK
            nfd = os.open(p, fl, dir_fd=fd)
            os.close(fd)
            fd = nfd
        return fd
    except BaseException:
        os.close(fd)
        raise


def owners():
    return {0, pwd.getpwnam('arm').pw_uid}


def open_reg(path):
    fd = walk(path)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid not in owners():
        os.close(fd)
        raise OSError('not a regular file owned by arm or root')
    return fd, st


def read_small(path, cap):
    fd, st = open_reg(path)
    try:
        if st.st_size > cap:
            raise OSError('larger than %d bytes' % cap)
        return os.read(fd, cap + 1)[:cap]
    finally:
        os.close(fd)


def read_tail(path, cap):
    fd, st = open_reg(path)
    try:
        if st.st_size > cap:
            os.lseek(fd, st.st_size - cap, 0)
        data = b''
        while len(data) < cap:
            c = os.read(fd, cap - len(data))
            if not c:
                break
            data += c
        return data
    finally:
        os.close(fd)


# Review round 1, F5: the largest file this reader hashes is one nightly custom-format dump (the weekly restore's dump in arm's
# directory on production, the pulled copy on streamanator). 16 GiB is far above a dump of afldb_prod and, at the sha256 rates of
# both hosts (hundreds of MB/s), hashes well inside the unit's 900 s TimeoutStartSec; a larger (or sparse, or growing) file is
# refused before or while reading, so arm can cause a STOP, never an unbounded root job.
HASH_CAP = 16 << 30


def sha256_of(path):
    fd, st = open_reg(path)
    h = hashlib.sha256()
    n = 0
    try:
        if st.st_size > HASH_CAP:
            raise OSError('larger than %d bytes' % HASH_CAP)
        while True:
            c = os.read(fd, 1 << 20)
            if not c:
                break
            n += len(c)
            if n > st.st_size or n > HASH_CAP:
                raise OSError('the file grew while it was hashed')
            h.update(c)
        return h.hexdigest(), st.st_size
    finally:
        os.close(fd)


def exists_nofollow(path):
    d, n = path.rsplit('/', 1)
    fd = walk(d, leaf_dir=True)
    try:
        os.stat(n, dir_fd=fd, follow_symlinks=False)
        return True
    except FileNotFoundError:
        return False
    finally:
        os.close(fd)


def readlink_nofollow(path):
    d, n = path.rsplit('/', 1)
    fd = walk(d, leaf_dir=True)
    try:
        return os.readlink(n, dir_fd=fd)
    finally:
        os.close(fd)


def err(e):
    return getattr(e, 'strerror', None) or str(e)


def jfield(path, keys, prefix):
    try:
        j = json.loads(read_small(path, 65536).decode('utf-8', 'replace'))
        emit(prefix + '_json_id', j.get('id'))
        for k, name in keys:
            emit(prefix + '_' + name, j.get(k))
    except Exception as e:  # noqa: BLE001
        emit(prefix + '_json_error', err(e))


def failed_markers():
    try:
        fd = walk(BK + '/.state', leaf_dir=True)
        try:
            names = sorted(n for n in os.listdir(fd) if n.startswith('FAILED-'))
        finally:
            os.close(fd)
        emit('bk_state_readable', 'yes')
        for n in names:
            try:
                c = read_small(BK + '/.state/' + n, 4096).decode('utf-8', 'replace')
            except Exception as e:  # noqa: BLE001
                c = '(unreadable: %s)' % err(e)
            emit('failed_marker', n + ' ' + c.strip())
    except Exception as e:  # noqa: BLE001
        emit('bk_state_readable', 'no ' + err(e))
        emit('failed_marker', '(arm .state unreadable: %s)' % err(e))


def facts_prod(req):
    failed_markers()
    if req == 'g0':
        return
    # the service's main process and its working directory (kernel fact; CAP_SYS_PTRACE)
    r = subprocess.run(['/usr/bin/systemctl', 'show', '-p', 'MainPID', '--value', 'afldb'], capture_output=True,
                       env={'PATH': '/usr/sbin:/usr/bin', 'LC_ALL': 'C'}, timeout=20)
    pid = r.stdout.decode().strip()
    emit('afldb_mainpid', pid)
    if re.fullmatch(r'[1-9][0-9]*', pid):
        try:
            emit('afldb_main_cwd', os.readlink('/proc/%s/cwd' % pid))
        except OSError as e:
            emit('afldb_main_cwd_error', err(e))
    for name, pre in (('current', 'cur'), ('previous', 'prev')):
        try:
            t = readlink_nofollow(RELROOT + '/' + name)
            emit(name + '_link', t)
            m = re.fullmatch(r'releases/(' + RELID.pattern + ')', t)
            if m:
                if name == 'current':
                    # Review round 1 (INFO), recorded rather than changed: realpath() lstat()s and readlink()s the components of an
                    # arm-owned path with DAC bypass and FOLLOWS arm's symbolic links. It opens no file and reads no content; the
                    # resulting path string goes only to the verifier, which compares it with the MainPID's cwd (also arm-chosen).
                    # The comparison proves only which directory the process runs in (README section 4, item 4).
                    emit('current_realpath', os.path.realpath(RELROOT + '/releases/' + m.group(1)))
                jfield(RELROOT + '/releases/' + m.group(1) + '/release.json',
                       (('revision', 'revision'), ('buildId', 'buildid'), ('afldbEnv', 'env')), pre)
        except FileNotFoundError:
            emit(name + '_link_error', 'absent')
        except Exception as e:  # noqa: BLE001
            emit(name + '_link_error', err(e))
    try:
        cur = readlink_nofollow(RELROOT + '/current')[len('releases/'):]
        last = None
        for line in read_tail(RELROOT + '/events.log', 8 << 20).decode('utf-8', 'replace').split('\n'):
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if isinstance(e, dict) and e.get('op') == 'status-pass' and e.get('id') == cur:
                last = e.get('invocationId')
        emit('events_last_pass_invocation', last if last else 'none')
    except Exception as e:  # noqa: BLE001
        emit('events_error', err(e))
    try:
        fd = walk(CHK, leaf_dir=True)
        os.close(fd)
        emit('checkout_present', 'yes')
    except Exception as e:  # noqa: BLE001
        emit('checkout_present', 'no ' + err(e))
    try:
        env = read_small(CHK + '/.env', 1 << 20).decode('utf-8', 'replace').split('\n')
        emit('env_url_count', sum(1 for l in env if l.startswith('AFLDB_REVALIDATE_URL=')))
        emit('env_secret_count', sum(1 for l in env if l.startswith('AFLDB_REVALIDATE_SECRET=')))
    except Exception as e:  # noqa: BLE001
        emit('env_error', err(e))
    try:
        head = read_small(CHK + '/.git/HEAD', 4096).decode().strip()
        if re.fullmatch(r'[0-9a-f]{40}', head):
            emit('checkout_head', head)
        else:
            m = re.fullmatch(r'ref: (refs/[A-Za-z0-9._/-]{1,200})', head)
            if not m or '..' in m.group(1):
                raise OSError('HEAD is not a ref or a commit')
            try:
                emit('checkout_head', read_small(CHK + '/.git/' + m.group(1), 4096).decode().strip()[:40])
            except FileNotFoundError:
                for l in read_small(CHK + '/.git/packed-refs', 4 << 20).decode('utf-8', 'replace').split('\n'):
                    if l.endswith(' ' + m.group(1)):
                        emit('checkout_head', l[:40])
                        break
                else:
                    raise OSError('ref not found')
    except Exception as e:  # noqa: BLE001
        emit('checkout_head_error', err(e))
    try:
        fd, st = open_reg(A1)
        os.close(fd)
        emit('a1_baseline', 'nonempty' if st.st_size > 0 else 'empty')
    except Exception as e:  # noqa: BLE001
        emit('a1_baseline', 'absent ' + err(e))
    for n, k in (('last-verify.json', 'state_last_verify'), ('last-backup.json', 'state_last_backup')):
        try:
            emit(k, read_small(BK + '/.state/' + n, 16384).decode('utf-8', 'replace').strip())
        except Exception as e:  # noqa: BLE001
            emit(k + '_error', err(e))
    try:
        fd = walk(BK, leaf_dir=True)
        try:
            emit('dumps_held', sum(1 for n in os.listdir(fd) if n.endswith('.dump')))
        finally:
            os.close(fd)
    except Exception as e:  # noqa: BLE001
        emit('dumps_held', '? ' + err(e))
    try:
        j = json.loads(read_small(BK + '/.state/last-verify.json', 16384).decode('utf-8', 'replace'))
        f = j.get('file')
        if isinstance(f, str) and re.fullmatch(r'afldb_prod-[0-9]{8}-03[0-5][0-9][0-5][0-9]\.dump', f):
            emit('restore_dump', '%s %s' % (f, sha256_of(BK + '/' + f)[0]))
        else:
            emit('restore_dump', 'none')
    except Exception as e:  # noqa: BLE001
        emit('restore_dump', 'none ' + err(e))


def facts_offhost(day, dump):
    try:
        h, size = sha256_of(DEST + '/' + dump)
        emit('dump_sha256', h)
        emit('dump_size', size)
    except Exception as e:  # noqa: BLE001
        emit('dump_error', err(e))
    for k, p in (('verified_marker', DEST + '/.verified-' + dump),):
        try:
            fd, st = open_reg(p)
            os.close(fd)
            emit(k, 'yes')
        except Exception:  # noqa: BLE001
            emit(k, 'no')
    try:
        emit('retention_hold', 'yes' if exists_nofollow(DEST + '/.retention-hold') else 'no')
    except Exception as e:  # noqa: BLE001
        emit('retention_hold', 'unknown ' + err(e))
    try:
        lines = read_small(DEST + '/' + dump + '.sha256', 4096).decode('utf-8', 'replace').split('\n')
        if lines and lines[-1] == '':
            lines.pop()
        emit('sidecar_lines', len(lines))
        for l in lines:
            emit('sidecar_line', l)
    except Exception as e:  # noqa: BLE001
        emit('sidecar_lines', 'error ' + err(e))
    try:
        for l in read_small(CRONTAB, 1 << 20).decode('utf-8', 'replace').split('\n'):
            emit('crontab_line', l)
        emit('crontab_readable', 'yes')
    except Exception as e:  # noqa: BLE001
        emit('crontab_readable', 'no ' + err(e))
    try:
        for l in read_tail(PULL_LOG, 4 << 20).decode('utf-8', 'replace').split('\n'):
            f = l.split(' ')
            if len(f) >= 2 and f[1] in ('BEGIN', 'END', 'RECEIVED', 'RECEIPT', 'HELD'):  # r10: r9's VERIFIED no longer counts
                emit('pull_log', l)
        emit('pull_log_readable', 'yes')
    except Exception as e:  # noqa: BLE001
        emit('pull_log_readable', 'no ' + err(e))


def main():
    conn = socket.socket(fileno=0)
    conn.settimeout(15)
    req = b''
    while b'\n' not in req and len(req) < 200:
        c = conn.recv(200)
        if not c:
            break
        req += c
    req = req.split(b'\n')[0].decode('ascii', 'replace')
    with open(ROLE_FILE) as f:
        role = f.read().strip()
    if role == 'prod' and req in ('a2', 'g0'):
        facts_prod(req)
    elif role == 'offhost' and re.fullmatch(r'g0b [0-9]{4}-[0-9]{2}-[0-9]{2} afldb_prod-[0-9]{8}-02(2[0-9]|30)[0-5][0-9]\.dump', req):
        _, day, dump = req.split(' ')
        if dump[11:19] != day.replace('-', ''):
            emit('request_error', 'dump date differs from the gate date')
            out.append('end\terror')
        else:
            facts_offhost(day, dump)
    else:
        emit('request_error', 'request not served by this role (%s)' % role)
        out.append('end\terror')
    if not out or out[-1] != 'end\terror':
        out.append('end\tok')
    data = ('\n'.join(out) + '\n').encode('ascii', 'replace')
    conn.settimeout(60)
    conn.sendall(data)
    conn.shutdown(socket.SHUT_WR)


if __name__ == '__main__':
    try:
        main()
    except Exception as e:  # noqa: BLE001
        try:
            sys.stdout.write('end\terror\n')
            sys.stdout.flush()
        except Exception:  # noqa: BLE001
            pass
        sys.exit(1)
