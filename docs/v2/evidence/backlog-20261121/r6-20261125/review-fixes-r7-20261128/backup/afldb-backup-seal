#!/usr/bin/bash
# afldb-backup-seal: R6 r7 (28 Nov 2026) root sealer and publisher of afldb-backup.service. PREPARED, NOT INSTALLED. Installed by
# install-backup.sh as /usr/local/lib/afldb-backup/afldb-backup-seal, root:root 0755. Contract: review-fixes-r7-20261128/DESIGN.md
# sections 3.1 (step 2), 3.2 (seal format afldb-backup-seal/4), 3.3 (retention), 3.4 (dispatch kind) and 3.6 (completion record).
# Review round 1 (28 Nov): F3 seals the timer's realtime activation and labels catch-up from it, whatever RandomizedDelaySec does;
# F4 writes a completion record as the very last step, without which sealed_origin never accepts the seal.
# Runs as ROOT, as the unit's only ExecStartPost:
#   ExecStartPost=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin /usr/bin/bash --noprofile --norc /usr/local/lib/afldb-backup/afldb-backup-seal
# (no '-': any failure here fails the unit and fires OnFailure=), after ExecStart (User=afldb-backup) exited 0, while the run's
# start job is still live (unit activating/start-post).
# 1. Removes stale root temporaries (.*.tmp) an interrupted earlier seal left in published/, seals/ and state/.
# 2. Reads PID 1's facts exactly as the r6 writer did (one `systemctl show`, busctl on the live job and on the timer).
# 3. Requires staging to hold exactly the run's dump afldb_prod-<8d>-<6d>.dump (regular, non-empty, link count 1, owned by
#    afldb-backup, modified at or after the main start) and its sidecar, and nothing else.
# 4. Copies the dump into a ROOT-ONLY temporary published/.<invocation>.tmp (root 0400), hashes THAT copy, and requires the hash
#    to equal the staging sidecar's. No arm process can touch staging, the copy, or any process of the run (DESIGN section 4).
# 5. Writes the seal seals/<invocation>.seal (root:root 0644, written .<invocation>.tmp then renamed, never overwritten) BEFORE
#    publication. If PID 1's facts are valid but step 3 or 4 fails, a seal with dump=none is written (raw facts) and the run fails.
# 6. Publishes: root:afldb-backup-read 0440, rename to the final name (never over an existing file); the root sidecar
#    "<sha256>  <name>" the same way; state/last-backup.json (today's JSON shape) root:afldb-backup-read 0440.
# 7. Retention: published keeps the newest 14 dumps by name, sidecars follow their dump; seals are kept.
# 8. Removes the staging copy.
# 9. LAST: writes the completion record seals/<invocation>.done (root:root 0644, .<invocation>.done.tmp then renamed, never
#    overwritten). A failure anywhere before it (publication, state record, retention, staging removal) leaves no completion
#    record, so that seal and its published dump are never eligible (DESIGN 3.6, review F4).
# Any failure: no rename of what failed, this run's temporaries removed, exit non-zero. It never reads, sources or executes
# anything under /home, and executes only root-owned helpers by absolute path.
cd / || exit 90
export LC_ALL=C PATH=/usr/sbin:/usr/bin
umask 077
set -u -o pipefail
shopt -s nullglob dotglob
SELF=/usr/local/lib/afldb-backup/afldb-backup-seal
ROOT=/var/lib/afldb-backup; STG=$ROOT/staging; SEALS=$ROOT/seals; PUB=$ROOT/published; STATE=$ROOT/state
RGRP=afldb-backup-read; BUSER=afldb-backup; KEEP=14
SVC=afldb-backup.service
SOBJ=/org/freedesktop/systemd1/unit/afldb_2dbackup_2eservice
TOBJ=/org/freedesktop/systemd1/unit/afldb_2dbackup_2etimer
BUS=org.freedesktop.systemd1
NUM='^(0|[1-9][0-9]{0,17})$'                                  # at most 18 digits: safe in bash's 64-bit arithmetic
NAMERE='^afldb_prod-[0-9]{8}-[0-9]{6}\.dump$'
TMPS=(); DONE=0
cleanup() { local t; [ "$DONE" = 1 ] && return 0; for t in "${TMPS[@]}"; do [ -e "$t" ] || [ -L "$t" ] && /usr/bin/rm -f -- "$t"; done; return 0; }
trap cleanup EXIT
die() { printf 'afldb-backup-seal: FAILED: %s\n' "$1" >&2; exit 1; }
tmo() { /usr/bin/timeout -k 2 5 "$@"; }                       # every systemctl / busctl call is bounded

for d in "$ROOT" "$SEALS" "$PUB" "$STATE" "$STG"; do [ -d "$d" ] && [ ! -L "$d" ] || die "$d is missing or a symbolic link"; done

# 1. Stale root temporaries of an interrupted earlier seal (only root writes these three directories).
for t in "$PUB"/.*.tmp "$SEALS"/.*.tmp "$STATE"/.*.tmp; do /usr/bin/rm -f -- "$t" || die "cannot remove the stale temporary $t"; done

# 2. PID 1's facts. The service: ONE `systemctl show` (one consistent snapshot); every value must match its own pattern.
declare -A S
out=$(tmo /usr/bin/systemctl show "$SVC" --timestamp=unix -p InvocationID -p Job -p ActiveState -p SubState -p ExecMainCode \
  -p ExecMainStatus -p InactiveEnterTimestampMonotonic -p InactiveExitTimestampMonotonic -p ExecMainStartTimestampMonotonic \
  -p ExecMainStartTimestamp -p User) || die "systemctl show $SVC failed"
while IFS= read -r l; do
  [[ $l =~ ^([A-Za-z]{1,64})=(.*)$ ]] && [ -z "${S[${BASH_REMATCH[1]}]+x}" ] || die "unexpected line from systemctl show $SVC"
  S[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
done <<< "$out"
[ "${#S[@]}" = 11 ] || die "systemctl show $SVC printed ${#S[@]} properties, not 11"
for k in InvocationID Job ActiveState SubState ExecMainCode ExecMainStatus InactiveEnterTimestampMonotonic InactiveExitTimestampMonotonic \
  ExecMainStartTimestampMonotonic ExecMainStartTimestamp User; do [ -n "${S[$k]+x}" ] || die "systemctl show $SVC did not print $k"; done
inv=${S[InvocationID]}; job=${S[Job]}
[[ $inv =~ ^[0-9a-f]{32}$ ]] || die "InvocationID unreadable"
[[ $job =~ ^[1-9][0-9]{0,9}$ ]] || die "no live job"           # the start job exists only while the run is starting
[ "${S[User]}" = "$BUSER" ] || die "the unit's User= is '${S[User]:0:64}', not $BUSER"
for k in ActiveState SubState; do [[ ${S[$k]} =~ ^[a-z-]{1,32}$ ]] || die "$k malformed"; done
for k in ExecMainCode ExecMainStatus; do [[ ${S[$k]} =~ ^[0-9]{1,3}$ ]] || die "$k malformed"; done
for k in InactiveEnterTimestampMonotonic InactiveExitTimestampMonotonic ExecMainStartTimestampMonotonic; do
  [[ ${S[$k]} =~ $NUM ]] || die "$k malformed"; done
[[ ${S[ExecMainStartTimestamp]} =~ ^@([1-9][0-9]{8,10})$ ]] || die "ExecMainStartTimestamp malformed"; mst=${BASH_REMATCH[1]}

# The live start job: it must belong to this unit; its type and its OWN ActivationDetails (a timer-created job carries
# trigger_unit and trigger_timer_realtime_usec; a job from `systemctl start` carries none).
out=$(tmo /usr/bin/busctl get-property "$BUS" "/org/freedesktop/systemd1/job/$job" org.freedesktop.systemd1.Job Unit JobType ActivationDetails) \
  || die "busctl: job $job unreadable"
mapfile -t J <<< "$out"
[ "${#J[@]}" = 3 ] || die "busctl printed ${#J[@]} lines for job $job"
[ "${J[0]}" = "(so) \"$SVC\" \"$SOBJ\"" ] || die "job $job does not belong to $SVC"
re='^s "([a-z-]{1,32})"$'; [[ ${J[1]} =~ $re ]] || die "JobType malformed"; jtype=${BASH_REMATCH[1]}
re='^a\(ss\) (0|[1-9][0-9]?)(( "[a-z_]{1,64}" "[A-Za-z0-9_.@:-]{0,255}")*)$'
[[ ${J[2]} =~ $re ]] || die "ActivationDetails malformed"
cnt=${BASH_REMATCH[1]}; rest=${BASH_REMATCH[2]}; seen=0; tunit=none; tusec=none
re='^ "([a-z_]+)" "([^"]*)"(.*)$'
while [[ $rest =~ $re ]]; do
  k=${BASH_REMATCH[1]}; v=${BASH_REMATCH[2]}; rest=${BASH_REMATCH[3]}; seen=$((seen + 1))
  case $k in
    trigger_unit) [ "$tunit" = none ] && [[ $v =~ ^[A-Za-z0-9_.@:-]{1,255}$ ]] || die "trigger_unit malformed or repeated"; tunit=$v;;
    trigger_timer_realtime_usec) [ "$tusec" = none ] && [[ $v =~ ^[1-9][0-9]{0,17}$ ]] || die "trigger_timer_realtime_usec malformed or repeated"; tusec=$v;;
  esac
done
[ -z "$rest" ] && [ "$seen" = "$cnt" ] || die "ActivationDetails count $cnt does not match its $seen pairs"

# The timer: LastTriggerUSec (realtime, microseconds) and its monotonic twin, and when the timer unit last became active.
out=$(tmo /usr/bin/busctl get-property "$BUS" "$TOBJ" org.freedesktop.systemd1.Timer LastTriggerUSec LastTriggerUSecMonotonic) || die "busctl: timer unreadable"
mapfile -t T <<< "$out"
[ "${#T[@]}" = 2 ] && [[ ${T[0]} =~ ^t\ ([0-9]{1,18})$ ]] && tlu=${BASH_REMATCH[1]} && [[ ${T[1]} =~ ^t\ ([0-9]{1,18})$ ]] && tlm=${BASH_REMATCH[1]} \
  && [[ $tlu =~ $NUM && $tlm =~ $NUM ]] || die "timer LastTriggerUSec malformed"
# The timer unit's last activation, realtime and monotonic (microseconds), in ONE busctl read of the Unit interface.
out=$(tmo /usr/bin/busctl get-property "$BUS" "$TOBJ" org.freedesktop.systemd1.Unit ActiveEnterTimestamp ActiveEnterTimestampMonotonic) \
  || die "busctl: timer activation unreadable"
mapfile -t T <<< "$out"
[ "${#T[@]}" = 2 ] && [[ ${T[0]} =~ ^t\ ([0-9]{1,18})$ ]] && tar=${BASH_REMATCH[1]} && [[ ${T[1]} =~ ^t\ ([0-9]{1,18})$ ]] && tam=${BASH_REMATCH[1]} \
  && [[ $tar =~ $NUM && $tam =~ $NUM ]] || die "timer ActiveEnterTimestamp malformed"   # 0 when the timer was never active (a hand start)
# DESIGN 3.4 (review round 1, F3): catch-up when the timer unit became active (realtime) at or after 02:20:00 Australia/Melbourne on
# the dispatch's Melbourne date (the calendar instant was missed: a boot or an attended re-arm after it), or when the dispatch came
# within 5 s of that activation; otherwise scheduled. It does not depend on RandomizedDelaySec, which systemd also applies to a
# missed elapse. sealed_origin recomputes it from the sealed stamps.
c0=0                                                          # the timer never dispatched (a hand start): only the 5 s rule applies
if (( tlu > 0 )); then
  dd=$(TZ=Australia/Melbourne /usr/bin/date -d "@$((tlu / 1000000))" +%F) && [[ $dd =~ ^20[0-9]{2}-[01][0-9]-[0-3][0-9]$ ]] || die "cannot compute the dispatch's Melbourne date"
  c0=$(TZ=Australia/Melbourne /usr/bin/date -d "$dd 02:20" +%s) && [[ $c0 =~ ^[1-9][0-9]{8,10}$ ]] || die "cannot compute $dd 02:20 Australia/Melbourne"
fi
if (( (c0 > 0 && tar >= c0 * 1000000) || tlm - tam < 5000000 )); then kind=catch-up; else kind=scheduled; fi

read -r boot < /proc/sys/kernel/random/boot_id || die "boot_id unreadable"
boot=${boot//-/}; [[ $boot =~ ^[0-9a-f]{32}$ ]] || die "boot_id malformed"

# 3 + 4. The run's dump: staging must hold exactly <name> and <name>.sha256, both regular, link count 1, owned by afldb-backup.
# The dump is copied into a root-only temporary FIRST and everything that decides the seal is checked on that root-owned copy.
tmp=$PUB/.$inv.tmp; dump=none; dsha=none; dbytes=none; why=
ents=("$STG"/*)
if [ "${#ents[@]}" != 2 ]; then why="staging holds ${#ents[@]} entries, not exactly the dump and its sidecar"
else
  name=; for e in "${ents[@]}"; do b=${e##*/}; [[ $b =~ $NAMERE ]] && name=$b; done
  if [ -z "$name" ] || [ ! -e "$STG/$name.sha256" ]; then why="staging holds no afldb_prod-<8 digits>-<6 digits>.dump with its sidecar"
  else
    st=$(/usr/bin/stat -c '%F|%h|%U|%Y|%s' -- "$STG/$name" 2>/dev/null); ss=$(/usr/bin/stat -c '%F|%h|%U|%s' -- "$STG/$name.sha256" 2>/dev/null)
    IFS='|' read -r ft fl fo fm fs <<< "$st"; IFS='|' read -r sft sfl sfo sfs <<< "$ss"
    if [ "$ft|$fl|$fo" != "regular file|1|$BUSER" ] || ! [[ $fm =~ ^[0-9]{1,11}$ && $fs =~ ^[1-9][0-9]{0,17}$ ]]; then
      why="$name is not a regular, non-empty, link-count-1 file owned by $BUSER ($st)"
    elif (( fm < mst )); then why="$name was modified at epoch $fm, before the main start ($mst)"
    elif [ "$sft|$sfl|$sfo" != "regular file|1|$BUSER" ] || ! [[ $sfs =~ ^[0-9]{1,3}$ ]] || (( sfs != 64 + 2 + ${#name} + 1 )); then
      why="$name.sha256 is not a regular, link-count-1, $BUSER-owned one-line sidecar ($ss)"
    else
      side=; IFS= read -r side < "$STG/$name.sha256"
      sre="^([0-9a-f]{64})  ${name//./\\.}\$"
      if ! [[ $side =~ $sre ]]; then why="$name.sha256 does not read '<sha256>  $name'"
      else
        ssha=${BASH_REMATCH[1]}
        TMPS+=("$tmp")
        if ! /usr/bin/timeout -k 5 1200 /usr/bin/cp -P --no-preserve=all -- "$STG/$name" "$tmp"; then why="cannot copy $name into $tmp"
        elif [ -L "$tmp" ] || [ ! -f "$tmp" ]; then why="the root copy $tmp is not a regular file (cp -P never follows a link)"
        elif ! /usr/bin/chmod 0400 -- "$tmp"; then why="cannot chmod $tmp"
        else
          ct=$(/usr/bin/stat -c '%F|%h|%u|%a|%s' -- "$tmp" 2>/dev/null)
          h=$(/usr/bin/timeout -k 5 1200 /usr/bin/sha256sum < "$tmp")
          if [ "$ct" != "regular file|1|0|400|$fs" ]; then why="the root copy $tmp is not a regular root 0400 file of $fs bytes ($ct)"
          elif ! [[ $h =~ ^([0-9a-f]{64})\ \ -$ ]]; then why="cannot hash the root copy $tmp"
          elif [ "${BASH_REMATCH[1]}" != "$ssha" ]; then why="the root copy hashes to ${BASH_REMATCH[1]:0:16}..., the staging sidecar says ${ssha:0:16}..."
          else dump=$name; dsha=$ssha; dbytes=$fs; fi
        fi
      fi
    fi
  fi
fi

# Consistency: the unit is still in the same invocation and the same job (the facts above were not of a later run).
out=$(tmo /usr/bin/systemctl show "$SVC" -p InvocationID -p Job --value) || die "systemctl show $SVC (re-read) failed"
mapfile -t R <<< "$out"
[ "${#R[@]}" = 2 ] && { [ "${R[0]}/${R[1]}" = "$inv/$job" ] || [ "${R[0]}/${R[1]}" = "$job/$inv" ]; } || die "the invocation or job changed while reading"

# 5. The seal, BEFORE publication. Raw facts for every successful ExecStart (a start by hand included: trigger_unit=none).
wsha=$(/usr/bin/sha256sum < "$SELF") || die "cannot hash $SELF"
[[ $wsha =~ ^([0-9a-f]{64})\ \ -$ ]] && wsha=${BASH_REMATCH[1]} || die "sha256sum output malformed"
now=${EPOCHREALTIME/./}; [[ $now =~ ^[1-9][0-9]{15,17}$ ]] || die "clock unreadable"
seal=$SEALS/$inv.seal; stmp=$SEALS/.$inv.tmp
[ ! -e "$seal" ] && [ ! -L "$seal" ] || die "a seal for invocation $inv already exists (never overwritten)"
TMPS+=("$stmp"); umask 022
set -C                                                        # noclobber: the temporary name must be new
printf '%s\n' "afldb-backup-seal/4" "sealer_sha256=$wsha" "unit=$SVC" "invocation=$inv" "job=$job" "job_type=$jtype" \
  "active_state=${S[ActiveState]}" "sub_state=${S[SubState]}" "exec_main_code=${S[ExecMainCode]}" "exec_main_status=${S[ExecMainStatus]}" \
  "service_user=$BUSER" "inactive_enter_mono=${S[InactiveEnterTimestampMonotonic]}" "inactive_exit_mono=${S[InactiveExitTimestampMonotonic]}" \
  "exec_main_start_mono=${S[ExecMainStartTimestampMonotonic]}" "trigger_unit=$tunit" "trigger_timer_realtime_usec=$tusec" \
  "timer_last_trigger_usec=$tlu" "timer_last_trigger_mono=$tlm" "timer_active_enter_mono=$tam" "timer_active_enter_usec=$tar" \
  "dispatch_kind=$kind" \
  "dump=$dump" "dump_sha256=$dsha" "dump_bytes=$dbytes" "boot_id=$boot" "sealed_realtime_usec=$now" > "$stmp" || die "cannot create $stmp"
set +C; umask 077
/usr/bin/mv -n -T -- "$stmp" "$seal" || die "cannot rename $stmp"
[ ! -e "$stmp" ] || die "a seal for invocation $inv appeared; $stmp not renamed"
[ "$dump" != none ] || die "sealed invocation $inv with dump=none: $why"

# 6. Publication: the dump, then its root sidecar, then the state record. Never over an existing file.
fin=$PUB/$dump; sfin=$fin.sha256; sctmp=$PUB/.$inv.sha256.tmp; jtmp=$STATE/.last-backup.json.tmp
[ ! -e "$fin" ] && [ ! -L "$fin" ] && [ ! -e "$sfin" ] && [ ! -L "$sfin" ] || die "$fin or its sidecar already exists (never overwritten)"
[ -f "$tmp" ] && [ ! -L "$tmp" ] || die "the root copy $tmp vanished or changed type"
/usr/bin/chown "root:$RGRP" -- "$tmp" && /usr/bin/chmod 0440 -- "$tmp" || die "cannot set root:$RGRP 0440 on $tmp"
/usr/bin/mv -n -T -- "$tmp" "$fin" && [ ! -e "$tmp" ] || die "cannot rename $tmp to $fin"
TMPS+=("$sctmp" "$jtmp")
set -C; printf '%s  %s\n' "$dsha" "$dump" > "$sctmp" || die "cannot create $sctmp"; set +C
/usr/bin/chown "root:$RGRP" -- "$sctmp" && /usr/bin/chmod 0440 -- "$sctmp" || die "cannot set root:$RGRP 0440 on $sctmp"
/usr/bin/mv -n -T -- "$sctmp" "$sfin" && [ ! -e "$sctmp" ] || die "cannot rename $sctmp to $sfin"
ts=$(/usr/bin/date -u +%FT%TZ) || die "date failed"
set -C; printf '{"epoch":%s,"ts":"%s","file":"%s","sha256":"%s","bytes":%s,"offhost":"skipped"}\n' "${now:0:${#now}-6}" "$ts" "$dump" "$dsha" "$dbytes" > "$jtmp" \
  || die "cannot create $jtmp"; set +C
/usr/bin/chown "root:$RGRP" -- "$jtmp" && /usr/bin/chmod 0440 -- "$jtmp" && /usr/bin/mv -f -T -- "$jtmp" "$STATE/last-backup.json" \
  || die "cannot write $STATE/last-backup.json"

# 7. Retention: the newest KEEP dumps by name (the name carries the stamp); sidecars follow their dump; seals are kept.
pubs=("$PUB"/afldb_prod-*.dump); keep=()
for p in "${pubs[@]}"; do [[ ${p##*/} =~ $NAMERE ]] && [ -f "$p" ] && [ ! -L "$p" ] && keep+=("$p"); done
n=${#keep[@]}
for (( i = 0; i < n - KEEP; i++ )); do /usr/bin/rm -f -- "${keep[i]}" "${keep[i]}.sha256" || die "retention: cannot remove ${keep[i]}"; done

# 8. The staging copy (the published root copy is now the only one).
/usr/bin/rm -f -- "$STG/$dump" "$STG/$dump.sha256" || die "cannot remove the staging copy of $dump"

# 9. LAST: the completion record. Only a run that reaches this line can ever be accepted (DESIGN 3.6).
dfin=$SEALS/$inv.done; dtmp=$SEALS/.$inv.done.tmp
[ ! -e "$dfin" ] && [ ! -L "$dfin" ] || die "a completion record for invocation $inv already exists (never overwritten)"
fnow=${EPOCHREALTIME/./}; [[ $fnow =~ ^[1-9][0-9]{15,17}$ ]] || die "clock unreadable"
TMPS+=("$dtmp"); umask 022
set -C; printf '%s\n' "afldb-backup-done/1" "invocation=$inv" "dump=$dump" "dump_sha256=$dsha" "completed_realtime_usec=$fnow" > "$dtmp" \
  || die "cannot create $dtmp"; set +C; umask 077
/usr/bin/mv -n -T -- "$dtmp" "$dfin" && [ ! -e "$dtmp" ] || die "cannot rename $dtmp to $dfin"
DONE=1
printf 'afldb-backup-seal: sealed %s (%s, trigger %s, dispatch %s) and published %s sha256 %s\n' "$inv" "$kind" "$tunit" "$tusec" "$dump" "${dsha:0:16}" >&2
exit 0
