## invite-token spellings, one request each (token = PROBE-INVITE-bbb222)
canonical                                      http=200
canonical + query                              http=200
leading //                                     http=404
leading ///                                    http=404
dot segment first                              http=404
dot segment inside                             http=404
dotdot                                         http=404
encoded slash prefix                           http=404
encoded slashes in the path                    http=404
encoded slash before token                     http=404
encoded first segment                          http=404
encoded invite (lower hex)                     http=200
encoded invite (upper letter)                  http=200
all of invite encoded                          http=200
upper case                                     http=200
double slash before token                      http=404
dot segment before token                       http=404
dotdot before token                            http=404
extra segment after token                      http=200
encoded backslash                              http=404
backslash                                      http=404
token then malformed escape (400)              http=400
token in a query, canonical path               http=200
list page (must stay readable)                 http=200
words that only contain invite                 http=200
absolute-form //admin/invite/T                  http=404
absolute-form /./admin/invite/T                 http=404
