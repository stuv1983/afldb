# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
# Leading slashes matter. An unanchored `build/` matches at ANY depth, so
# it silently excluded tools/build/prepare-standalone.mjs — a script the
# build script itself invokes. The clone on a fresh host therefore failed
# at the last step of `npm run build`, and only there.
.next/
out/
/build/
next-env.d.ts

# TypeScript incremental build cache. Host-specific and regenerated by every
# `tsc`, so a committed copy only ever arrives at the next host stale.
*.tsbuildinfo

# Agent/editor session state.
# Note the `/*` rather than a trailing slash: `.claude/` stops git descending into
# the directory at all, so no `!` negation beneath it can ever re-include anything.
# `.claude/*` ignores each entry instead, which leaves the negations below able to fire.
# The PhanesLight-generated agent roster, workflow definitions and prompt templates are
# reviewable project infrastructure, not session state, so they are tracked; the real
# session state (settings.local.json and anything else) stays ignored.
.claude/*
!.claude/agents/
!.claude/workflows/
!.claude/template/
!.claude/.phaneslight
/.tmp/issue-206/

# PhanesLight run state. The shared infrastructure -- config.json, manifest.json and
# scripts/ -- is tracked; per-run machine state is not. `registry/` is the generated API
# baseline, regenerated from source by `regen-registry` on every close, so a committed
# copy only ever arrives stale (the same reasoning as *.tsbuildinfo above).
.phaneslight/run-progress
.phaneslight/run-progress.prev
.phaneslight/returns/
.phaneslight/registry/
.phaneslight/inventory/

# Visual-evidence captures written by afldb-closure under the Visual Evidence Mandate.
# Screenshots are large, binary, and reproducible by re-running the capture against the same
# commit, so they are output rather than repository content -- the same reasoning as
# /artifacts/ and playwright-report/ above. The VERDICT lives in the session summary, which
# is tracked; only the raw frames are ignored.
/reports/ui-evidence/

# The Projects-in-Motion register: a personal, per-operator working file that is
# rewritten constantly. Its closed entries are condensed into tracked archive digests
# under documentation/archive/projects/, so nothing durable is lost by ignoring it.
/CLAUDE.local.md

# Environment / secrets — never commit
.env
.env.local
.env.*.local
.env.production
*.pem
*.key

# Databases, dumps and backups — never commit
# Anchored for the same reason as /build/ above: this is the top-level
# data directory (afl.db, the AFLW parsed CSVs), not any nested one.
# Raw databases and generated datasets stay local. Curated, reviewable import
# manifests may opt in explicitly below so a fresh deployment can reproduce
# the same sourced facts.
/data/*
# AFLDB-ISSUE-113: the season-grain Brownlow artefact, its provenance manifest and the
# identity adjudication file are curated, hash-bound inputs of the canonical rebuild.
!/data/brownlow/
/data/brownlow/*
!/data/brownlow/season-votes.csv
!/data/brownlow/season-votes.manifest.json
!/data/brownlow/player-identity.csv
!/data/awards/
/data/awards/*
!/data/awards/22-under-22.csv
!/data/awards/honour-teams.csv
!/data/awards/hall-of-fame.csv
!/data/awards/captaincies.csv
!/data/awards/rising-star.csv
!/data/awards/all-australian.csv
!/data/awards/club-best-and-fairest.csv
!/data/awards/club-best-and-fairest-definitions.csv
!/data/awards/named-medals.csv
!/data/awards/named-medals-definitions.csv
!/data/awards/award-definitions.csv
!/data/awards/rising-star-winners.csv
!/data/awards/player-identity.csv
# AFLDB-ISSUE-118 §23.19/§23.26: curated, tracked player height evidence (the Wikipedia
# infobox corroboration set) and the operator adjudications of height source conflicts.
!/data/players/
/data/players/*
!/data/players/height-evidence-wikipedia.csv
!/data/players/height-adjudications.csv
!/data/players/father-son-selections.csv
!/data/players/father-son-selections.source.json
!/data/players/father-son-adjudications.csv
# AFLDB-ISSUE-222 §11.19.12/§11.19.13: the tracked, independently-sourced review outcomes of the
# eight pickrookie disagreements (operator decision D2).
!/data/players/rookie-relisting-outcomes.csv
# AFLDB-ISSUE-118 §23.31: the normalised sibling pairs, their provenance and the adjudications;
# the raw operator export under data/players/families/ stays untracked.
!/data/players/sibling-relationships.csv
!/data/players/sibling-relationships.source.json
!/data/players/sibling-adjudications.csv
!/data/players/sibling-supplements.csv
!/data/records/
/data/records/*
!/data/records/first-kick-goal-ids.csv
# AFLDB-ISSUE-118 §23.33: the normalised after-siren artefact, provenance and adjudications are tracked;
# the raw table exports under data/records/after-siren/ stay untracked.
!/data/records/after-siren-events.csv
!/data/records/after-siren-events.source.json
!/data/records/after-siren-adjudications.csv
# ISSUE-093 Phase-1 canonical reference datasets: curated, reviewable, tracked.
# Only JSON opts in; raw/large data under data/ (incl. data/sources/) stays ignored.
!/data/reference/
/data/reference/*
!/data/reference/*.json
# AFLDB-ISSUE-118 §23.27 Stage E2: the parsed AFL Tables coaches snapshot (index + coach
# pages, two small CSVs per capture) is the rebuild's tracked input; the raw HTML beside
# it stays local and is hash-bound by the tracked manifest under docs/rebuild-manifests/.
!/data/sources/
/data/sources/*
!/data/sources/afltables/
/data/sources/afltables/*
!/data/sources/afltables/coaches/
/data/sources/afltables/coaches/*
!/data/sources/afltables/coaches/*/
/data/sources/afltables/coaches/*/*
!/data/sources/afltables/coaches/*/parsed/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.sql.gz
backups/

