# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
# Leading slashes matter. An unanchored `build/` matches at ANY depth, so
# it silently excluded tools/build/prepare-standalone.mjs — a script the
# build script itself invokes. The clone on a fresh host therefore failed
# at the last step of `npm run build`, and only there.
.next/
out/
/build/
next-env.d.ts

# TypeScript incremental build cache. Host-specific and regenerated by every
# `tsc`, so a committed copy only ever arrives at the next host stale.
*.tsbuildinfo

# Agent/editor session state
.claude/

# Environment / secrets — never commit
.env
.env.local
.env.*.local
.env.production
*.pem
*.key

# Databases, dumps and backups — never commit
# Anchored for the same reason as /build/ above: this is the top-level
# data directory (afl.db, the AFLW parsed CSVs), not any nested one.
# Raw databases and generated datasets stay local. Curated, reviewable import
# manifests may opt in explicitly below so a fresh deployment can reproduce
# the same sourced facts.
/data/*
# AFLDB-ISSUE-113: the season-grain Brownlow artefact, its provenance manifest and the
# identity adjudication file are curated, hash-bound inputs of the canonical rebuild.
!/data/brownlow/
/data/brownlow/*
!/data/brownlow/season-votes.csv
!/data/brownlow/season-votes.manifest.json
!/data/brownlow/player-identity.csv
!/data/awards/
/data/awards/*
!/data/awards/22-under-22.csv
!/data/awards/honour-teams.csv
!/data/awards/hall-of-fame.csv
!/data/awards/captaincies.csv
!/data/awards/rising-star.csv
!/data/awards/all-australian.csv
!/data/awards/club-best-and-fairest.csv
!/data/awards/club-best-and-fairest-definitions.csv
!/data/awards/named-medals.csv
!/data/awards/named-medals-definitions.csv
!/data/awards/award-definitions.csv
!/data/awards/rising-star-winners.csv
!/data/awards/player-identity.csv
!/data/records/
/data/records/*
!/data/records/first-kick-goal-ids.csv
# ISSUE-093 Phase-1 canonical reference datasets: curated, reviewable, tracked.
# Only JSON opts in; raw/large data under data/ (incl. data/sources/) stays ignored.
!/data/reference/
/data/reference/*
!/data/reference/*.json
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.sql.gz
backups/

# Source caches
.cache/
tools/**/cache/
tools/**/raw/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Stress-test output. `npm run nl:stress -- --out ./nl-stress-out` is the
# documented invocation and lands in the repo root; a full run is ~12 MB
# of results.jsonl.
nl-stress-out/
nl-ui-out/

# Diagnostic/forensic output directory -- e.g. tests/nl-ui/nl-stress.spec.ts's
# per-incident hydration capture (raw server HTML, post-hydration DOM,
# screenshot) and tests/admin-nav's timing/screenshot dumps. Large,
# binary-ish, and reproducible by re-running the relevant harness -- not
# something to commit. Anchored: this is the top-level scratch directory,
# not any nested one. A whole 391 MB of exactly this (including manually
# renamed/archived copies like artifacts/hydration-20260818-preserved)
# was accidentally committed directly to a shared branch on 2026-08-19
# because the old narrower `artifacts/hydration/` pattern didn't cover a
# renamed sibling directory -- this one covers the whole class instead.
/artifacts/

# Same reasoning, for ad-hoc renamed/archived copies of the NL UI sweep's
# nl-ui-out/ output (e.g. nl-ui-out-fwab-baseline/, nl-ui-out-*-archive/).
nl-ui-out-*/

# Playwright's saved storageState for the NL UI sweep (tests/nl-ui/auth.setup.ts).
# This is not sample data -- it is a live, HMAC-signed afldb_beta session
# cookie, regenerated by the setup project on every run. A committed copy
# is a credential sitting in git history for no operational reason.
tests/nl-ui/.auth/

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
/afldb-nl-mass-corpus.csv
/afldb-nl-mass-corpus.csv.summary.json
