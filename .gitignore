# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
# Leading slashes matter. An unanchored `build/` matches at ANY depth, so
# it silently excluded tools/build/prepare-standalone.mjs — a script the
# build script itself invokes. The clone on a fresh host therefore failed
# at the last step of `npm run build`, and only there.
.next/
out/
/build/
next-env.d.ts

# Environment / secrets — never commit
.env
.env.local
.env.*.local
.env.production
*.pem
*.key

# Databases, dumps and backups — never commit
# Anchored for the same reason as /build/ above: this is the top-level
# data directory (afl.db, the AFLW parsed CSVs), not any nested one.
/data/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.sql.gz
backups/

# Source caches
.cache/
tools/**/cache/
tools/**/raw/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
