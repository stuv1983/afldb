# AFLDB environment configuration template
# Copy to .env and fill in real values. NEVER commit .env.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# NODE_ENV is deliberately NOT set here. Next.js sets it itself (development
# for `next dev`, production for `next build`/`next start`), and overriding it
# from .env produces inconsistent builds.

# TRANSPORT SECURITY posture: development | staging | production.
#
# `production` turns on three things together — Secure session cookies, HSTS,
# and the CSP that drops 'unsafe-eval'. Set it on EVERY host reachable over
# public HTTPS, whether or not that host is ready to be indexed. A plain-HTTP
# host (the LAN dev server) must NOT set it: a Secure cookie silently fails to
# set over HTTP, which locks you out of your own admin.
#
# It does NOT control indexing. That is AFLDB_INDEXING below, and the two are
# separate because holding this at `development` to keep a pre-cutover host
# out of search results also stripped Secure off its cookies. See
# src/lib/indexing.ts.
#
# Read at BUILD time by next.config.ts, so changing it needs a rebuild.
AFLDB_ENV=development

# INDEXING GATE. Fails closed: anything but `on` means robots.txt returns
# Disallow: / and every page emits noindex. Turned on only at the deliberate
# cutover, once the site is publicly correct on its real domain. The beta gate
# overrides it regardless — a crawler behind a gate can only index the door.
# AFLDB_INDEXING=on

# Public base URL used for canonical links and the sitemap.
# During development this MUST point at the dev server, never at afldb.com.
#
# On a host with AFLDB_INDEXING=on this must be the bare production origin
# over https, with no trailing slash, query string or fragment. It becomes
# `metadataBase`, so if it is wrong or unset EVERY page tells Google its
# preferred URL is one no crawler can reach, and none of the site is indexed.
# `npm test` fails on that combination — see the launch gate in tests/seo.test.ts.
AFLDB_BASE_URL=http://10.0.40.100:3100

# Port for the Next.js service (3000 is already in use on the dev server)
PORT=3100

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Read-oriented application role used by the website.
DATABASE_URL=postgresql://afldb_app:CHANGE_ME@localhost:5432/afldb_dev

# Elevated role used only by ETL/import tooling.
AFLDB_IMPORT_DATABASE_URL=postgresql://afldb_import:CHANGE_ME@localhost:5432/afldb_dev

# Schema owner, used only by migrations.
AFLDB_OWNER_DATABASE_URL=postgresql://afldb_owner:CHANGE_ME@localhost:5432/afldb_dev

# Integration tests run against a separate database. The suite refuses to
# run unless the database name ends in _test: it issues real mutations.
AFLDB_TEST_DATABASE_URL=postgresql://afldb_owner:CHANGE_ME@localhost:5432/afldb_test

# Optional restricted credential for importer role-parity integration tests.
# It MUST target the same *_test database as AFLDB_TEST_DATABASE_URL but log in
# as afldb_import. When absent, restricted importer-role tests skip explicitly;
# they never fall back to the owner credential.
AFLDB_TEST_IMPORT_DATABASE_URL=postgresql://afldb_import:CHANGE_ME@localhost:5432/afldb_test

# Read-only role used by pg_dump. tools/maintenance/backup.sh requires it
# and does NOT fall back to the owner: a backup must not hold write
# privileges. The database name here decides the backup filenames.
AFLDB_BACKUP_DATABASE_URL=postgresql://afldb_backup:CHANGE_ME@localhost:5432/afldb_dev

# Production schema owner. Only AFLDB_MIGRATE_TARGET=prod uses it, and the
# migration runner refuses to run rather than guessing when it is unset.
# Leave commented out until the production database exists.
# AFLDB_PROD_DATABASE_URL=postgresql://afldb_owner:CHANGE_ME@localhost:5432/afldb_prod

# ---------------------------------------------------------------------------
# Authentication and beta access
# ---------------------------------------------------------------------------
# Role that writes ONLY the operational auth/submission tables (migration
# 023). Created by tools/maintenance/02_add_auth_role.sh; the public
# afldb_app role stays read-only.
AFLDB_AUTH_DATABASE_URL=postgresql://afldb_auth:CHANGE_ME@localhost:5432/afldb_dev

# Signs beta and admin cookies. 32+ characters. Rotating it signs every
# visitor and administrator out at once.
AFLDB_SESSION_SECRET=CHANGE_ME_TO_48_RANDOM_CHARACTERS

# Closed beta: "on" requires an access code or allowlisted email for the
# whole site (except /beta and /admin/login). Anything else means open.
AFLDB_BETA_GATE=off

# Bumping this number invalidates every outstanding beta admission at
# once — the kill switch if a code leaks. Codes themselves are revoked
# individually in /admin/access.
AFLDB_BETA_EPOCH=1

# ---------------------------------------------------------------------------
# Email CSV intake
# ---------------------------------------------------------------------------
# tools/email_intake/fetch_and_stage.py polls a mailbox for admin-submitted
# CSVs and forwards each to /api/admin/email-intake -- a second channel into
# the SAME staged/validated/approved/promoted pipeline /admin/upload uses.
# Leave AFLDB_EMAIL_INTAKE_SECRET unset to disable the route entirely.

# Shared secret between the poller and the app. Server-to-server only --
# never a browser session. 32+ random characters.
AFLDB_EMAIL_INTAKE_SECRET=CHANGE_ME_TO_32_RANDOM_CHARACTERS

# IMAP mailbox the poller reads. AFLDB_INTAKE_IMAP_PORT defaults to 993
# (implicit TLS); AFLDB_INTAKE_IMAP_MAILBOX defaults to INBOX.
AFLDB_INTAKE_IMAP_HOST=CHANGE_ME
# AFLDB_INTAKE_IMAP_PORT=993
AFLDB_INTAKE_IMAP_USER=CHANGE_ME
AFLDB_INTAKE_IMAP_PASSWORD=CHANGE_ME
# AFLDB_INTAKE_IMAP_MAILBOX=INBOX

# Folders a processed message is copied to (never deleted, never moved --
# the original always stays in the mailbox as a record). Created
# automatically if missing.
# AFLDB_INTAKE_PROCESSED_FOLDER=Processed
# AFLDB_INTAKE_ERROR_FOLDER=Errors

# Where the poller POSTs. Defaults to http://127.0.0.1:$PORT -- the app runs
# on the same host, so the secret never touches the network. Deliberately NOT
# AFLDB_BASE_URL: that is the site's public address, and sending the secret
# there would route it out through the proxy and back. Set this only if the
# poller genuinely runs on another host, and then use https.
# AFLDB_INTAKE_URL=http://127.0.0.1:3100

# Seconds to wait for the intake route. Validation is per row and a large
# file legitimately takes minutes; a message that times out is retried on
# the next poll rather than lost, and the route deduplicates on the file's
# SHA-256 so the retry cannot double-stage it.
# AFLDB_INTAKE_HTTP_TIMEOUT=180

# A From address is a claim, not a credential. The poller refuses any message
# the RECEIVING mail server did not verify (Authentication-Results recording
# dmarc=pass, or spf=pass with dkim=pass); otherwise knowing an admin's email
# address would be enough to submit data as them. Turn this off only where
# something upstream already guarantees it.
# AFLDB_INTAKE_REQUIRE_AUTH=true
# Optional: the mail server's own authserv-id, required to match the one on
# the header. Closes the gap on a server that does not strip inbound
# Authentication-Results headers before adding its own.
# AFLDB_INTAKE_AUTHSERV_ID=mx.your-mail-host.com

# ---------------------------------------------------------------------------
# External AFL data sources
# ---------------------------------------------------------------------------
# tools/current-season/update-current-season.ts stages current-season match
# snapshots from external APIs, then optionally updates local completed match
# scores when the local match resolves unambiguously.
#
# Squiggle requires a User-Agent identifying the bot and contact email. Do not
# route visitors' browsers directly to Squiggle; the refresh tool fetches
# server-side and stores a local snapshot.
AFLDB_EXTERNAL_API_USER_AGENT=AFLDB current-season refresh (contact: data@afldb.com)

# Kali AFL Stats API key. Keep it here or in protected service config only.
# Required for `npm run current-season:update -- --source kali`.
# KALI_AFL_API_KEY=CHANGE_ME
# Optional override for local/proxy testing.
# KALI_AFL_API_BASE_URL=https://kaliaflstats.com/api/afl/v1

# ---------------------------------------------------------------------------
# Outbound email (SMTP relay)
# ---------------------------------------------------------------------------
# Used by the early-access request form to notify requests@afldb.com, and by
# the beta magic-link sender. Leave AFLDB_SMTP_HOST unset and nothing is sent:
# requests are still saved and still reviewable at /admin/access, which is the
# system of record either way.
#
# A RELAY is required, not direct delivery. The production droplet is on
# DigitalOcean, where outbound port 25 is blocked and mail from a droplet IP is
# filed as spam regardless. Use whichever provider hosts afldb.com mail, or a
# dedicated sender (Postmark, SES, Resend, Fastmail).
#
# These are SECRETS and stay here, in a mode-600 file. They deliberately do NOT
# live in site_settings: that table is public-readable by design (migration
# 034). What a super admin configures at /admin/settings is the recipient and
# the on/off switch, never the credential.

# AFLDB_SMTP_HOST=smtp.example.net
# AFLDB_SMTP_PORT=587
# 465 is implicit TLS, 587/25 use STARTTLS. Derived from the port unless set.
# AFLDB_SMTP_SECURE=false
# AFLDB_SMTP_USER=CHANGE_ME
# AFLDB_SMTP_PASSWORD=CHANGE_ME
# The envelope sender. Must be an address the relay is allowed to send as.
# AFLDB_SMTP_FROM=AFLDB <no-reply@afldb.com>

# ---------------------------------------------------------------------------
# Legacy source (read-only)
# ---------------------------------------------------------------------------
# AFLDB never writes to this file.
AFLDB_LEGACY_SQLITE=/home/arm/projects/sports_data_lab/data/afl/afl.db

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
# Cluster worker count, and the app pool size each worker holds. These are
# one decision: the service can hold workers x (AFLDB_POOL_MAX + 3)
# connections, the +3 being the separate auth pool in src/db/authClient.ts.
#
# THIS FILE IS THE ONLY PLACE THEY ARE SET. deploy/afldb.service used to
# hardcode them and would have overridden whatever is here; it no longer
# does, because the two hosts need different values and one unit file
# serves both. Set them per machine:
#
#   development (24 cores, 31 GB)   AFLDB_WORKERS=4
#   production  (2 vCPU, 4 GB)      AFLDB_WORKERS=2
#
# One worker per vCPU is the starting point. Raise it only once
# `journalctl -u afldb` shows CPU saturating before memory does.
AFLDB_WORKERS=4
AFLDB_POOL_MAX=10

# Development-only request/build tracing. Enable this for the ISSUE-107
# deployment gate and leave it enabled through ISSUE-068's final hydration
# acceptance so every response carries x-afldb-build/x-afldb-worker evidence.
# It also writes one trace line per request to journald, so it is opt-in rather
# than a permanent production default.
# AFLDB_TRACE_REQUESTS=on

# Static-generation workers for `next build`. Prerendering forks a worker
# per core, each opening a 2-connection pool. Leave unset against a local
# PostgreSQL (max_connections=100) — Next's default is correct there. Set
# it only when building against a managed database with a low connection
# limit, where an unbounded build dies with "too many clients" partway.
# AFLDB_BUILD_WORKERS=4

# Where backups are written and pruned.
AFLDB_BACKUP_DIR=/home/arm/backups/afldb

# ---------------------------------------------------------------------------
# The apex coming-soon page
# ---------------------------------------------------------------------------
# Where /admin/content PUBLISHES afldb.com to. Caddy serves this directory as
# static files (deploy/Caddyfile.production), so the application writes the
# page but never serves it — which is what keeps the apex up while the app is
# restarting or the database is down.
#
# LEAVE THIS UNSET on any host that does not serve the apex, including
# development. Unset means "save to the database, publish nothing", and the
# admin screen says so rather than failing.
#
# On the production droplet it also needs the matching ReadWritePaths= line in
# deploy/afldb.service and the directory to be owned by the service user:
#   sudo chown -R arm:caddy /var/www/afldb-soon && sudo chmod 750 /var/www/afldb-soon
# AFLDB_APEX_DIR=/var/www/afldb-soon

# Where the page's stylesheet, script and shipped screenshots are read from.
# Defaults to deploy/coming-soon relative to the working directory, which
# tools/build/prepare-standalone.mjs copies into the standalone bundle. Only
# set this for an unusual layout.
# AFLDB_APEX_TEMPLATE_DIR=

# ---------------------------------------------------------------------------
# Query abuse protection
# ---------------------------------------------------------------------------
AFLDB_MAX_PAGE_SIZE=100
AFLDB_MAX_FILTERS=20
AFLDB_STATEMENT_TIMEOUT_MS=5000
